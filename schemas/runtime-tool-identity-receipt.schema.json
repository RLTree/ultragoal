{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/runtime-tool-identity-receipt.schema.json",
  "title": "Harness Ultragoal Runtime Tool Identity Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool_identity",
    "workspace",
    "artifact_digests",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.runtime-tool-identity-receipt.v1"
    },
    "tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "binary_path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "binary_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "artifact_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
      }
    },
    "claim_ceiling": {
      "enum": [
        "same_tool_runtime_surface_only",
        "withheld_until_runtime_identity_proven"
      ]
    }
  }
}
