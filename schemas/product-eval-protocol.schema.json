{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/product-eval-protocol.schema.json",
  "title": "product-eval-protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_ids",
    "eval_scenarios",
    "red_paths",
    "green_paths",
    "negative_paths",
    "first_value_path",
    "time_to_value_path",
    "adoption_loop",
    "continuance_signal",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.product-eval-protocol.v1"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "eval_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "red_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "green_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negative_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "first_value_path": {
      "type": "string",
      "minLength": 1
    },
    "time_to_value_path": {
      "type": "string",
      "minLength": 1
    },
    "adoption_loop": {
      "type": "string",
      "minLength": 1
    },
    "continuance_signal": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
