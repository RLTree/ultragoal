{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/product-eval-protocol.schema.json",
  "title": "product-eval-protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_ids",
    "eval_scenarios",
    "red_paths",
    "green_paths",
    "negative_paths",
    "first_value_path",
    "time_to_value_path",
    "adoption_loop",
    "continuance_signal",
    "behavior_evaluation",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.product-eval-protocol.v1"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "eval_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "red_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "green_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negative_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "first_value_path": {
      "type": "string",
      "minLength": 1
    },
    "time_to_value_path": {
      "type": "string",
      "minLength": 1
    },
    "adoption_loop": {
      "type": "string",
      "minLength": 1
    },
    "continuance_signal": {
      "type": "string",
      "minLength": 1
    },
    "behavior_evaluation": {
      "$ref": "#/$defs/behavior_evaluation"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "behavior_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_families", "dimensions", "splits", "repair_budget", "claim_ceiling"],
      "properties": {
        "case_families": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["baseline", "negative", "overlap", "already_specified", "no_change", "held_out", "semantic_mutation", "specification_evolution"]
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": ["activation", "instruction_following", "authority_composition", "verified_outcome", "trajectory_recovery", "no_change_judgment", "effect_security", "evidence_honesty", "supervisory_burden", "cost_latency"]
          }
        },
        "splits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "negative", "overlap", "already_specified", "no_change", "held_out", "semantic_mutation", "specification_evolution"],
          "properties": {
            "baseline": { "$ref": "#/$defs/non_empty_strings" },
            "negative": { "$ref": "#/$defs/non_empty_strings" },
            "overlap": { "$ref": "#/$defs/non_empty_strings" },
            "already_specified": { "$ref": "#/$defs/non_empty_strings" },
            "no_change": { "$ref": "#/$defs/non_empty_strings" },
            "held_out": { "$ref": "#/$defs/non_empty_strings" },
            "semantic_mutation": { "$ref": "#/$defs/non_empty_strings" },
            "specification_evolution": { "$ref": "#/$defs/non_empty_strings" }
          }
        },
        "repair_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_family", "operating_envelope", "max_repair_attempts", "calibration_basis", "universal_count"],
          "properties": {
            "task_family": { "type": "string", "minLength": 1 },
            "operating_envelope": { "type": "string", "minLength": 1 },
            "max_repair_attempts": { "type": "integer", "minimum": 1 },
            "calibration_basis": { "type": "string", "minLength": 1 },
            "universal_count": { "const": false }
          }
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
