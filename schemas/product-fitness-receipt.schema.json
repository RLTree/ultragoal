{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/product-fitness-receipt.schema.json",
  "title": "Harness Ultragoal Product Fitness Receipt",
  "type": "object",
  "required": [
    "schema",
    "receipt_version",
    "claim",
    "target_revision",
    "target_audience",
    "job_to_be_done",
    "context_of_use",
    "desired_user_outcome",
    "business_or_mission_outcome",
    "critical_journey",
    "first_value_event",
    "continuance_signal",
    "assumption_tests",
    "user_evidence",
    "quality_in_use_metrics",
    "accessibility_gate",
    "cognitive_load_gate",
    "recovery_burden_gate",
    "proof_surface",
    "substitution_rejections",
    "claim_ceiling",
    "producer_actor_id",
    "reviewer_actor_id",
    "actor_disjoint",
    "generated_at",
    "receipt_digest"
  ],
  "properties": {
    "schema": {
      "enum": [
        "harness-ultragoal.product-fitness-receipt.v1",
        "harness-ultragoal.product-fitness-receipt.v2"
      ]
    },
    "receipt_version": {
      "type": "string",
      "minLength": 1
    },
    "operator_kind": {
      "enum": [
        "agent",
        "human",
        "agent_with_human_supervision"
      ]
    },
    "evidence_class": {
      "enum": [
        "intent",
        "research",
        "prototype",
        "source",
        "package",
        "installed",
        "runtime",
        "agent_use",
        "human_use",
        "repeated_human_use"
      ]
    },
    "surface_identities": {
      "$ref": "#/$defs/surfaceIdentities"
    },
    "public_entry_observation": {
      "$ref": "#/$defs/publicEntryObservation"
    },
    "real_work_observation": {
      "$ref": "#/$defs/realWorkObservation"
    },
    "manual_journey_row": {
      "$ref": "#/$defs/manualJourneyRow"
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "title",
        "repeated_use_claimed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "repeated_use_claimed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "target_revision": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "package_digest",
            "git_commit",
            "source_tree_digest"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "target_audience": {
      "$ref": "#/$defs/namedEvidence"
    },
    "job_to_be_done": {
      "type": "object",
      "required": [
        "job",
        "evidence"
      ],
      "properties": {
        "job": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "context_of_use": {
      "type": "object",
      "required": [
        "context",
        "evidence"
      ],
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "desired_user_outcome": {
      "type": "object",
      "required": [
        "outcome",
        "evidence"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "business_or_mission_outcome": {
      "type": "object",
      "required": [
        "outcome",
        "evidence"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "critical_journey": {
      "type": "object",
      "required": [
        "id",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "first_value_event": {
      "$ref": "#/$defs/eventEvidence"
    },
    "continuance_signal": {
      "type": "object",
      "required": [
        "required",
        "evidence"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "assumption_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assumptionTest"
      }
    },
    "user_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/userEvidence"
      }
    },
    "quality_in_use_metrics": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "accessibility_gate": {
      "$ref": "#/$defs/gate"
    },
    "cognitive_load_gate": {
      "$ref": "#/$defs/gate"
    },
    "recovery_burden_gate": {
      "$ref": "#/$defs/gate"
    },
    "proof_surface": {
      "type": "object",
      "required": [
        "kind",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "package_static_fixture",
            "live_same_surface",
            "withheld_or_blocked"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "substitution_rejections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/substitution"
      }
    },
    "claim_ceiling": {
      "enum": [
        "package_static_fixture_only",
        "withheld_or_blocked",
        "live_same_surface_proven"
      ]
    },
    "producer_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_disjoint": {
      "const": true
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "harness-ultragoal.product-fitness-receipt.v2"
          }
        }
      },
      "then": {
        "required": [
          "operator_kind",
          "evidence_class",
          "surface_identities",
          "public_entry_observation",
          "real_work_observation",
          "manual_journey_row"
        ]
      }
    }
  ],
  "$defs": {
    "surfaceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "withheld"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            }
          },
          "then": {
            "required": [
              "identity",
              "evidence"
            ]
          }
        }
      ]
    },
    "surfaceIdentities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "package",
        "marketplace",
        "install",
        "cache",
        "app_registry",
        "discovery",
        "runtime",
        "journey"
      ],
      "properties": {
        "source": { "$ref": "#/$defs/surfaceIdentity" },
        "package": { "$ref": "#/$defs/surfaceIdentity" },
        "marketplace": { "$ref": "#/$defs/surfaceIdentity" },
        "install": { "$ref": "#/$defs/surfaceIdentity" },
        "cache": { "$ref": "#/$defs/surfaceIdentity" },
        "app_registry": { "$ref": "#/$defs/surfaceIdentity" },
        "discovery": { "$ref": "#/$defs/surfaceIdentity" },
        "runtime": { "$ref": "#/$defs/surfaceIdentity" },
        "journey": { "$ref": "#/$defs/surfaceIdentity" }
      }
    },
    "publicEntryObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "route",
        "bypass_attempted",
        "bypass_rejected"
      ],
      "properties": {
        "surface_id": { "const": "PS-ENTRY" },
        "route": { "const": "harness-ultragoal" },
        "bypass_attempted": { "type": "boolean" },
        "bypass_rejected": { "type": "boolean" }
      }
    },
    "realWorkObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_identity",
        "task_id",
        "task",
        "useful_outcome"
      ],
      "properties": {
        "repository_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "task_id": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "useful_outcome": { "type": "string", "minLength": 1 }
      }
    },
    "manualJourneyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_to_verified_value_ms",
        "human_interventions",
        "review_rounds",
        "failure",
        "diagnosis",
        "recovery_outcome",
        "repeat_use_outcome",
        "retained_artifact_bytes",
        "retained_cache_bytes",
        "false_passes",
        "false_rejections"
      ],
      "properties": {
        "time_to_verified_value_ms": { "type": "integer", "minimum": 0 },
        "human_interventions": { "type": "integer", "minimum": 0 },
        "review_rounds": { "type": "integer", "minimum": 0 },
        "failure": { "type": "string" },
        "diagnosis": { "type": "string" },
        "recovery_outcome": { "type": "string", "minLength": 1 },
        "repeat_use_outcome": { "type": "string", "minLength": 1 },
        "retained_artifact_bytes": { "type": "integer", "minimum": 0 },
        "retained_cache_bytes": { "type": "integer", "minimum": 0 },
        "false_passes": { "type": "integer", "minimum": 0 },
        "false_rejections": { "type": "integer", "minimum": 0 }
      }
    },
    "namedEvidence": {
      "type": "object",
      "required": [
        "name",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "eventEvidence": {
      "type": "object",
      "required": [
        "event",
        "evidence"
      ],
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "assumptionTest": {
      "type": "object",
      "required": [
        "id",
        "hypothesis",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "userEvidence": {
      "type": "object",
      "required": [
        "audience",
        "job",
        "context",
        "outcome",
        "evidence"
      ],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "job": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": [
        "dimension",
        "measure",
        "evidence"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "effectiveness",
            "efficiency",
            "satisfaction",
            "freedom_from_risk",
            "context_coverage"
          ]
        },
        "measure": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "evidence"
      ],
      "properties": {
        "journey_binding": {
          "type": "string",
          "minLength": 1
        },
        "burden_assessment": {
          "type": "string",
          "minLength": 1
        },
        "recovery_path": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRef"
        }
      },
      "additionalProperties": false
    },
    "substitution": {
      "type": "object",
      "required": [
        "rejected_substitute",
        "reason"
      ],
      "properties": {
        "rejected_substitute": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
