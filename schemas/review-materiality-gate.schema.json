{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/review-materiality-gate.schema.json",
  "title": "Harness Ultragoal Deterministic Material Review Scope Gate",
  "description": "DELTA and ADVISORY are static fixture vocabulary only. Live validation blocks until candidate-bound change and executed-gate observations are available; receipt-declared trigger and gate names are never live authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_authority",
    "reviewer_output_authority",
    "decision",
    "confidence",
    "reason",
    "material_triggers",
    "deterministic_gates_required",
    "deterministic_gates_run",
    "anchors_checked",
    "reviewers_required",
    "reviewer_registry_evidence",
    "validator_repairs_recommended",
    "claim_ceiling",
    "output_may_be_used_for_material_signoff"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.review-materiality-gate.v2"
    },
    "decision_authority": {
      "const": "deterministic_rust"
    },
    "reviewer_output_authority": {
      "const": "falsification_only_cannot_raise_claims"
    },
    "decision": {
      "enum": [
        "FULL_SCOPE_MATERIAL_REVIEW_REQUIRED",
        "BOUNDED_INVARIANT_REVIEW_REQUIRED",
        "DELTA_REVIEW_ALLOWED",
        "ADVISORY_REVIEW_ALLOWED",
        "BLOCKED_BEFORE_REVIEW"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "material_triggers": {
      "description": "Static fixture vocabulary. Live Rust validation does not derive authority from this caller-supplied array.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "enum": [
          "material_claim_boundary",
          "bounded_invariant_change",
          "worktree_freeze",
          "major_root_integration",
          "product_claim_boundary",
          "release_claim_boundary",
          "completion_claim_boundary",
          "protected_cross_domain_change",
          "phase_advancement",
          "proof_anchor_change",
          "reviewer_registry_change",
          "persona_contract_change",
          "material_code_runtime_change",
          "prior_revise_or_blocked_repair",
          "regenerated_anchor_repair",
          "security_privacy_trust_boundary_change",
          "package_runtime_visibility_surface_change",
          "stale_anchor",
          "narrow_validator_only_change",
          "advisory_only_no_candidate_change"
        ]
      },
      "uniqueItems": true
    },
    "deterministic_gates_required": {
      "$ref": "#/$defs/gateList"
    },
    "deterministic_gates_run": {
      "description": "Static fixture vocabulary. A copied name list is not an executed-gate observation for live validation.",
      "$ref": "#/$defs/gateList"
    },
    "anchors_checked": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
      },
      "uniqueItems": true
    },
    "reviewers_required": {
      "type": "array",
      "items": {
        "enum": [
          "claim-falsifier",
          "orchestration-recovery-reviewer",
          "security-reviewer",
          "product-journey-reviewer"
        ]
      },
      "uniqueItems": true
    },
    "reviewer_registry_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
      },
      "uniqueItems": true
    },
    "validator_repairs_recommended": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "unsupported",
        "blocked"
      ],
      "properties": {
        "supported": {
          "$ref": "#/$defs/claimList"
        },
        "unsupported": {
          "$ref": "#/$defs/claimList"
        },
        "blocked": {
          "$ref": "#/$defs/claimList"
        }
      }
    },
    "output_may_be_used_for_material_signoff": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "FULL_SCOPE_MATERIAL_REVIEW_REQUIRED"
          }
        }
      },
      "then": {
        "properties": {
          "reviewers_required": {
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "BOUNDED_INVARIANT_REVIEW_REQUIRED"
          }
        }
      },
      "then": {
        "properties": {
          "reviewers_required": {
            "minItems": 1,
            "maxItems": 1
          },
          "material_triggers": {
            "items": {
              "enum": [
                "bounded_invariant_change",
                "worktree_freeze",
                "material_code_runtime_change",
                "prior_revise_or_blocked_repair"
              ]
            }
          },
          "claim_ceiling": {
            "properties": {
              "supported": {
                "not": {
                  "contains": {
                    "enum": [
                      "material_signoff",
                      "major_root_integration",
                      "product",
                      "readiness",
                      "release",
                      "completion"
                    ]
                  }
                }
              },
              "unsupported": {
                "allOf": [
                  {
                    "contains": {
                      "const": "material_signoff"
                    }
                  },
                  {
                    "contains": {
                      "const": "readiness"
                    }
                  },
                  {
                    "contains": {
                      "const": "release"
                    }
                  },
                  {
                    "contains": {
                      "const": "completion"
                    }
                  },
                  {
                    "contains": {
                      "const": "major_root_integration"
                    }
                  },
                  {
                    "contains": {
                      "const": "product"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "ADVISORY_REVIEW_ALLOWED",
              "BLOCKED_BEFORE_REVIEW"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reviewers_required": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "gateList": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "enum": [
          "anchor_existence_and_digest",
          "validator_receipt_status",
          "reviewer_registry_role_exposure",
          "stale_receipt_check",
          "package_private_artifact_hygiene",
          "readiness_validator",
          "claim_ceiling_check",
          "proof_surface_substitution_check"
        ]
      },
      "uniqueItems": true
    },
    "claimList": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
