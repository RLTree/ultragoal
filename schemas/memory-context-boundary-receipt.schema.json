{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/memory-context-boundary-receipt.schema.json",
  "title": "Harness Ultragoal Memory Context Boundary Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "memory_context_only",
    "memory_artifacts",
    "live_same_surface_evidence",
    "substitutions_rejected",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.memory-context-boundary-receipt.v1"
    },
    "memory_context_only": {
      "const": true
    },
    "memory_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-defs.schema.json#/$defs/artifactRef"
      }
    },
    "live_same_surface_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-defs.schema.json#/$defs/artifactRef"
      }
    },
    "substitutions_rejected": {
      "type": "array",
      "contains": {
        "const": "memory_only"
      },
      "items": {
        "enum": [
          "memory_only",
          "summary_only",
          "packet_only",
          "session_summary_only"
        ]
      }
    },
    "claim_ceiling": {
      "enum": [
        "live_same_surface_evidence_required",
        "withheld_until_live_same_surface_evidence"
      ]
    }
  }
}
