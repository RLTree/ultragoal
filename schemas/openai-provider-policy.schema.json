{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/openai-provider-policy.schema.json",
  "title": "Harness Ultragoal OpenAI Provider Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "law_id",
    "default_provider_mode",
    "default_budget_class",
    "allowed_provider_modes",
    "budget_classes",
    "forbidden_claim_substitutions"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.openai-provider-policy.v1"
    },
    "law_id": {
      "const": "openai-api-key-model-cost-external-ai-boundary"
    },
    "default_provider_mode": {
      "const": "no_network"
    },
    "default_budget_class": {
      "const": "source_no_network"
    },
    "allowed_provider_modes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "enum": [
          "openai_live",
          "offline_fixture",
          "local_mock",
          "no_network"
        ]
      }
    },
    "budget_classes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/budgetClass"
      },
      "required": [
        "source_no_network",
        "source_offline_fixture",
        "source_local_mock",
        "source_live_low"
      ]
    },
    "forbidden_claim_substitutions": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "budgetClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_modes",
        "max_prompt_tokens",
        "max_completion_tokens",
        "max_total_tokens",
        "cost_ceiling_usd",
        "timeout_ms",
        "max_retries",
        "backoff_policy",
        "backoff_initial_ms",
        "backoff_max_ms",
        "cache_policy",
        "no_cache_verification",
        "rate_limit_policy",
        "allowed_claim_ceiling"
      ],
      "properties": {
        "provider_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "openai_live",
              "offline_fixture",
              "local_mock",
              "no_network"
            ]
          }
        },
        "max_prompt_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "max_completion_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "max_total_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 400000
        },
        "cost_ceiling_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "backoff_policy": {
          "enum": [
            "none",
            "exponential_jitter"
          ]
        },
        "backoff_initial_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "backoff_max_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "cache_policy": {
          "type": "string",
          "minLength": 1
        },
        "no_cache_verification": {
          "type": "string",
          "minLength": 1
        },
        "rate_limit_policy": {
          "type": "string",
          "minLength": 1
        },
        "allowed_claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
