{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/product-strategy.schema.json",
  "title": "product-strategy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_ids",
    "target_problem",
    "approach",
    "primary_user_or_operator",
    "job_to_be_done",
    "success_metrics",
    "investment_tracks",
    "non_goals",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.product-strategy.v1"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_problem": {
      "type": "string",
      "minLength": 1
    },
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "primary_user_or_operator": {
      "type": "string",
      "minLength": 1
    },
    "job_to_be_done": {
      "type": "string",
      "minLength": 1
    },
    "success_metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "investment_tracks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
