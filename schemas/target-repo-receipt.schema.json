{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/target-repo-receipt.schema.json",
  "title": "Harness Ultragoal Target Repo Receipt",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "target_repo",
    "status",
    "requirements",
    "checks",
    "command",
    "validator_artifacts",
    "gate_markers",
    "invocation",
    "generated_at",
    "repo_fingerprint"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.target-repo-receipt.v1"
    },
    "mode": {
      "enum": [
        "init",
        "retrofit"
      ]
    },
    "target_repo": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "checks": {
      "type": "object",
      "required": [
        "baseline-file:AGENTS.md",
        "baseline-file:AGENT_STANDARDS.md",
        "baseline-file:ARCHITECTURE.md",
        "baseline-file:PLANS.md",
        "baseline-file:DESIGN.md",
        "baseline-file:FRONTEND.md",
        "baseline-file:PRODUCT_SENSE.md",
        "baseline-file:QUALITY_SCORE.md",
        "baseline-file:RELIABILITY.md",
        "baseline-file:SECURITY.md",
        "baseline-file:docs/design-docs/index.md",
        "baseline-file:docs/design-docs/core-beliefs.md",
        "baseline-file:docs/exec-plans/tech-debt-tracker.md",
        "baseline-file:docs/generated/index.md",
        "baseline-file:docs/product-specs/index.md",
        "baseline-file:docs/references/index.md",
        "baseline-dir:docs/design-docs",
        "baseline-dir:docs/exec-plans/active",
        "baseline-dir:docs/exec-plans/completed",
        "baseline-dir:docs/generated",
        "baseline-dir:docs/product-specs",
        "baseline-dir:docs/references",
        "baseline-dir:validation_artifacts",
        "agent-surface",
        "check-gate",
        "mode-provenance",
        "retrofit-backlog",
        "runtime-legibility"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "detail",
          "evidence"
        ],
        "properties": {
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not_applicable"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "common-defs.schema.json#/$defs/artifactRef"
          }
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "required": [
            "observability-stack"
          ]
        },
        {
          "required": [
            "product-cohesion"
          ]
        }
      ]
    },
    "command": {
      "$ref": "common-defs.schema.json#/$defs/commandReceipt"
    },
    "validator_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-defs.schema.json#/$defs/artifactRef"
      }
    },
    "invocation": {
      "type": "string",
      "minLength": 1
    },
    "gate_markers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "$ref": "common-defs.schema.json#/$defs/isoTimestamp"
    },
    "repo_fingerprint": {
      "$ref": "common-defs.schema.json#/$defs/sha256"
    },
    "requirements": {
      "type": "object",
      "required": [
        "observability_required",
        "observability_reason",
        "product_cohesion_required",
        "product_cohesion_reason"
      ],
      "properties": {
        "observability_required": {
          "type": "boolean"
        },
        "observability_reason": {
          "enum": [
            "not_requested",
            "requested",
            "claim_dependency"
          ]
        },
        "product_cohesion_required": {
          "type": "boolean"
        },
        "product_cohesion_reason": {
          "enum": [
            "not_requested",
            "requested",
            "claim_dependency"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "common-defs.schema.json#/$defs/claimId"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "not": {
                "properties": {
                  "status": {
                    "enum": [
                      "fail",
                      "blocked"
                    ]
                  }
                }
              }
            }
          },
          "gate_markers": {
            "allOf": [
              {
                "contains": {
                  "const": "baseline-files"
                }
              },
              {
                "contains": {
                  "const": "execplan-dirs"
                }
              },
              {
                "contains": {
                  "const": "proof-root"
                }
              }
            ]
          },
          "command": {
            "required": [
              "stdout",
              "stderr"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
