{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/source-cards.schema.json",
  "title": "Harness Ultragoal Source Cards",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "url",
      "retrieved_at",
      "used_for",
      "provenance",
      "retrieval_receipt",
      "snapshot",
      "cited_claims"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "minLength": 1
      },
      "retrieved_at": {
        "$ref": "common-defs.schema.json#/$defs/isoTimestamp"
      },
      "used_for": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "provenance": {
        "type": "object",
        "required": [
          "source_kind",
          "access_method",
          "digest_basis"
        ],
        "properties": {
          "source_kind": {
            "enum": [
              "live_url",
              "local_artifact"
            ]
          },
          "access_method": {
            "type": "string",
            "minLength": 1
          },
          "digest_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "notes": {
        "type": "string"
      },
      "retrieval_receipt": {
        "type": "object",
        "required": [
          "access_tool",
          "actor_id",
          "status",
          "retrieved_at",
          "output"
        ],
        "properties": {
          "access_tool": {
            "type": "string",
            "minLength": 1
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "retrieved",
              "blocked",
              "not_refreshed"
            ]
          },
          "retrieved_at": {
            "$ref": "common-defs.schema.json#/$defs/isoTimestamp"
          },
          "output": {
            "$ref": "common-defs.schema.json#/$defs/artifactRef"
          }
        },
        "additionalProperties": false
      },
      "snapshot": {
        "type": "object",
        "required": [
          "path",
          "digest",
          "snapshot_basis"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "common-defs.schema.json#/$defs/sha256"
          },
          "snapshot_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "cited_claims": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "proposal_claim",
            "source_support"
          ],
          "properties": {
            "proposal_claim": {
              "type": "string",
              "minLength": 1
            },
            "source_support": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
