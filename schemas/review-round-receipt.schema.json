{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/review-round-receipt.schema.json",
  "title": "Harness Ultragoal Four-Persona Review Round Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "round_id",
    "round_phase",
    "anchor_policy",
    "status",
    "generated_at",
    "validator_receipt",
    "live_registry_exposure",
    "review_target",
    "archive",
    "materiality_gate",
    "claim_ceiling",
    "reviewers"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.review-round-receipt.v1"
    },
    "round_id": {
      "type": "string",
      "minLength": 1
    },
    "round_phase": {
      "const": "sign_off"
    },
    "anchor_policy": {
      "const": "validator_review_target_archive"
    },
    "status": {
      "const": "pass"
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "validator_receipt": {
      "$ref": "#/$defs/boundArtifact"
    },
    "live_registry_exposure": {
      "$ref": "#/$defs/boundArtifact"
    },
    "review_target": {
      "$ref": "#/$defs/boundArtifact"
    },
    "archive": {
      "$ref": "#/$defs/boundArtifact"
    },
    "materiality_gate": {
      "$ref": "review-materiality-gate.schema.json"
    },
    "claim_ceiling": {
      "$ref": "#/$defs/claimCeiling"
    },
    "prior_round_reviewer_agent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "type": "string"
        },
        "package_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona",
        "agent_type",
        "persona_prompt_path",
        "persona_prompt_digest",
        "custom_agent_path",
        "custom_agent_digest",
        "prompt_packet",
        "model",
        "reasoning_effort",
        "sandbox_mode",
        "live_spawn_receipt",
        "reviewer_agent_id",
        "fresh_context",
        "reused_reviewer",
        "review_scope",
        "verdict",
        "validator_receipt_digest",
        "review_target_digest",
        "archive_digest",
        "review_report",
        "material_blockers",
        "counterexamples_attempted",
        "proof_anchors_checked",
        "claim_ceiling_assessment",
        "required_next_repairs",
        "evidence_paths_checked",
        "evidence_artifacts_checked",
        "completed_at"
      ],
      "properties": {
        "persona": {
          "enum": [
            "contract_claim_falsifier",
            "orchestration_recovery_falsifier",
            "security_trust_boundary_falsifier",
            "product_simplicity_falsifier"
          ]
        },
        "agent_type": {
          "enum": [
            "harness_contract_claim_falsifier",
            "harness_orchestration_recovery_falsifier",
            "harness_security_trust_boundary_falsifier",
            "harness_product_simplicity_falsifier"
          ]
        },
        "persona_prompt_path": {
          "type": "string"
        },
        "persona_prompt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "custom_agent_path": {
          "type": "string",
          "pattern": "^custom-agents/harness-[a-z-]+\\.toml$"
        },
        "custom_agent_digest": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_packet": {
          "$ref": "#/$defs/boundArtifact"
        },
        "model": {
          "const": "gpt-5.5"
        },
        "reasoning_effort": {
          "const": "high"
        },
        "sandbox_mode": {
          "const": "read-only"
        },
        "live_spawn_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "source_thread_id",
            "tool_invocation_id",
            "round_id",
            "captured_at",
            "agent_type",
            "spawned_reviewer_agent_id",
            "model",
            "reasoning_effort",
            "status"
          ],
          "properties": {
            "tool": {
              "const": "multi_agent_v1.spawn_agent"
            },
            "source_thread_id": {
              "type": "string",
              "minLength": 1
            },
            "tool_invocation_id": {
              "type": "string",
              "minLength": 1
            },
            "round_id": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "type": "string",
              "minLength": 20
            },
            "agent_type": {
              "type": "string",
              "minLength": 1
            },
            "spawned_reviewer_agent_id": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "reasoning_effort": {
              "const": "high"
            },
            "status": {
              "enum": [
                "spawned",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            }
          }
        },
        "reviewer_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "fresh_context": {
          "type": "boolean"
        },
        "reused_reviewer": {
          "type": "boolean"
        },
        "review_scope": {
          "const": "full_current_scope"
        },
        "verdict": {
          "const": "SIGN_OFF"
        },
        "validator_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "review_target_digest": {
          "$ref": "#/$defs/sha256"
        },
        "archive_digest": {
          "$ref": "#/$defs/sha256"
        },
        "review_report": {
          "$ref": "#/$defs/boundArtifact"
        },
        "material_blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewFinding"
          }
        },
        "counterexamples_attempted": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/counterexampleProbe"
          }
        },
        "proof_anchors_checked": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundArtifact"
          }
        },
        "claim_ceiling_assessment": {
          "$ref": "#/$defs/claimCeiling"
        },
        "required_next_repairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nextRepair"
          }
        },
        "evidence_paths_checked": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_artifacts_checked": {
          "type": "array",
          "minItems": 6,
          "items": {
            "$ref": "#/$defs/boundArtifact"
          }
        },
        "completed_at": {
          "type": "string",
          "minLength": 20
        },
        "product_fitness_required": {
          "const": true
        },
        "product_fitness_owner": {
          "const": "product_simplicity_falsifier"
        },
        "product_fitness_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "product_fitness_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "substitution_rejections_reviewed": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "generic_product_simplicity_approval",
              "product::cohesion",
              "install_success",
              "package_publication",
              "first_use",
              "smoke_test",
              "fixture_pass",
              "reviewer_agreement",
              "happy_path",
              "receipt_only"
            ]
          }
        },
        "product_fitness_disposition": {
          "$ref": "#/$defs/productFitnessDisposition"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "persona": {
                "const": "product_simplicity_falsifier"
              }
            }
          },
          "then": {
            "required": [
              "product_fitness_required",
              "product_fitness_owner",
              "product_fitness_receipt_digest",
              "product_fitness_claim_ids",
              "substitution_rejections_reviewed",
              "product_fitness_disposition"
            ]
          }
        }
      ]
    },
    "productFitnessDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_persona",
        "owner_agent_type",
        "applies_to_product_impacting_claims",
        "status",
        "receipt",
        "receipt_generated_at",
        "claim_ids_reviewed",
        "dimensions_checked",
        "substitution_rejection",
        "generic_product_simplicity_approval_only"
      ],
      "properties": {
        "owner_persona": {
          "const": "product_simplicity_falsifier"
        },
        "owner_agent_type": {
          "const": "harness_product_simplicity_falsifier"
        },
        "applies_to_product_impacting_claims": {
          "const": true
        },
        "status": {
          "enum": [
            "pass",
            "revise",
            "blocked"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/boundArtifact"
        },
        "receipt_generated_at": {
          "type": "string",
          "minLength": 20
        },
        "claim_ids_reviewed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dimensions_checked": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "audience",
              "job",
              "context",
              "outcome",
              "accessibility",
              "cognitive_load",
              "recovery_burden",
              "continuance",
              "real_use_evidence",
              "product_success_substitution_rejection"
            ]
          }
        },
        "substitution_rejection": {
          "const": true
        },
        "generic_product_simplicity_approval_only": {
          "const": false
        }
      }
    },
    "claimCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "unsupported"
      ],
      "properties": {
        "supported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimCeilingEntry"
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimCeilingEntry"
          }
        }
      }
    },
    "claimCeilingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "status",
        "rationale"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counterexampleProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "counterexample",
        "evidence"
      ],
      "properties": {
        "probe_id": {
          "type": "string",
          "minLength": 1
        },
        "counterexample": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/boundArtifact"
        }
      }
    },
    "nextRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repair_id",
        "disposition",
        "evidence"
      ],
      "properties": {
        "repair_id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "none_required",
            "required_before_next_phase"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/boundArtifact"
        }
      }
    },
    "reviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "summary",
        "evidence"
      ],
      "properties": {
        "severity": {
          "enum": [
            "blocker",
            "non_blocking"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
