{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/review-round-receipt.schema.json",
  "title": "Harness Ultragoal Canonical Falsification Review Round Receipt",
  "description": "Static receipt shape for falsification evidence. Live materiality remains blocked until candidate-bound change and executed-gate observations exist; runtime discovery remains unavailable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "round_id",
    "review_stage",
    "anchor_policy",
    "status",
    "generated_at",
    "review_authority",
    "runtime_metadata_ceiling",
    "validator_receipt",
    "live_registry_exposure",
    "review_target",
    "archive",
    "materiality_gate",
    "claim_ceiling",
    "prior_round_reviewer_agent_ids",
    "reviewers"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.review-round-receipt.v2"
    },
    "round_id": {
      "type": "string",
      "minLength": 1
    },
    "review_stage": {
      "const": "falsification"
    },
    "anchor_policy": {
      "const": "validator_review_target_archive"
    },
    "status": {
      "const": "evidence_complete"
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "review_authority": {
      "const": "falsification_evidence_only"
    },
    "runtime_metadata_ceiling": {
      "description": "No host model, mode, reasoning, discovery, or spawn provenance is established by inline receipt values.",
      "const": "unavailable_no_runtime_configuration_claim"
    },
    "validator_receipt": {
      "$ref": "#/$defs/boundArtifact"
    },
    "live_registry_exposure": {
      "$ref": "#/$defs/boundArtifact"
    },
    "review_target": {
      "$ref": "#/$defs/boundArtifact"
    },
    "archive": {
      "$ref": "#/$defs/boundArtifact"
    },
    "materiality_gate": {
      "description": "Live Rust validation ignores receipt-declared lower-scope trigger and gate-name authority and fails closed without trusted observations.",
      "$ref": "review-materiality-gate.schema.json"
    },
    "claim_ceiling": {
      "$ref": "#/$defs/claimCeiling"
    },
    "prior_round_reviewer_agent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "package_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtimeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure"
      ],
      "properties": {
        "exposure": {
          "const": "unavailable"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "agent_manifest_path",
        "agent_manifest_digest",
        "prompt_packet",
        "runtime_metadata",
        "sandbox_mode",
        "reviewer_authority",
        "live_spawn_receipt",
        "reviewer_agent_id",
        "fresh_context",
        "reused_reviewer",
        "review_scope",
        "falsification_result",
        "validator_receipt_digest",
        "review_target_digest",
        "archive_digest",
        "review_report",
        "material_blockers",
        "counterexamples_attempted",
        "proof_anchors_checked",
        "claim_ceiling_assessment",
        "required_next_repairs",
        "evidence_paths_checked",
        "evidence_artifacts_checked",
        "completed_at"
      ],
      "properties": {
        "role": {
          "enum": [
            "claim-falsifier",
            "orchestration-recovery-reviewer",
            "security-reviewer",
            "product-journey-reviewer"
          ]
        },
        "agent_manifest_path": {
          "enum": [
            ".codex/agents/claim-falsifier.toml",
            ".codex/agents/orchestration-recovery-reviewer.toml",
            ".codex/agents/security-reviewer.toml",
            ".codex/agents/product-journey-reviewer.toml"
          ]
        },
        "agent_manifest_digest": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_packet": {
          "$ref": "#/$defs/boundArtifact"
        },
        "runtime_metadata": {
          "$ref": "#/$defs/runtimeMetadata"
        },
        "sandbox_mode": {
          "const": "read-only"
        },
        "reviewer_authority": {
          "const": "falsification_only_cannot_raise_claims"
        },
        "live_spawn_receipt": {
          "$ref": "#/$defs/liveSpawnReceipt"
        },
        "reviewer_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "fresh_context": {
          "const": true
        },
        "reused_reviewer": {
          "const": false
        },
        "review_scope": {
          "const": "full_current_scope"
        },
        "falsification_result": {
          "const": "no_material_finding"
        },
        "validator_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "review_target_digest": {
          "$ref": "#/$defs/sha256"
        },
        "archive_digest": {
          "$ref": "#/$defs/sha256"
        },
        "review_report": {
          "$ref": "#/$defs/boundArtifact"
        },
        "material_blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewFinding"
          }
        },
        "counterexamples_attempted": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/counterexampleProbe"
          }
        },
        "proof_anchors_checked": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundArtifact"
          }
        },
        "claim_ceiling_assessment": {
          "$ref": "#/$defs/reviewerClaimAssessment"
        },
        "required_next_repairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nextRepair"
          }
        },
        "evidence_paths_checked": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_artifacts_checked": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundArtifact"
          }
        },
        "completed_at": {
          "type": "string",
          "minLength": 20
        },
        "product_fitness_required": {
          "const": true
        },
        "product_fitness_owner": {
          "const": "product-journey-reviewer"
        },
        "product_fitness_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "product_fitness_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "substitution_rejections_reviewed": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "generic_product_simplicity_approval",
              "product::cohesion",
              "install_success",
              "package_publication",
              "first_use",
              "smoke_test",
              "fixture_pass",
              "reviewer_agreement",
              "happy_path",
              "receipt_only"
            ]
          }
        },
        "product_fitness_disposition": {
          "$ref": "#/$defs/productFitnessDisposition"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "product-journey-reviewer"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "product_fitness_required",
              "product_fitness_owner",
              "product_fitness_receipt_digest",
              "product_fitness_claim_ids",
              "substitution_rejections_reviewed",
              "product_fitness_disposition"
            ]
          }
        }
      ]
    },
    "liveSpawnReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "source_thread_id",
        "tool_invocation_id",
        "round_id",
        "captured_at",
        "role",
        "spawned_reviewer_agent_id",
        "sandbox_mode",
        "runtime_metadata",
        "status"
      ],
      "properties": {
        "tool": {
          "const": "multi_agent_v1.spawn_agent"
        },
        "source_thread_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "round_id": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "minLength": 20
        },
        "role": {
          "enum": [
            "claim-falsifier",
            "orchestration-recovery-reviewer",
            "security-reviewer",
            "product-journey-reviewer"
          ]
        },
        "spawned_reviewer_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "sandbox_mode": {
          "const": "read-only"
        },
        "runtime_metadata": {
          "$ref": "#/$defs/runtimeMetadata"
        },
        "status": {
          "enum": [
            "spawned",
            "failed"
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "productFitnessDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_role",
        "reviewer_authority",
        "may_raise_claim_ceiling",
        "applies_to_product_impacting_claims",
        "status",
        "receipt",
        "receipt_generated_at",
        "claim_ids_reviewed",
        "dimensions_checked",
        "substitution_rejection",
        "generic_product_approval_only"
      ],
      "properties": {
        "owner_role": {
          "const": "product-journey-reviewer"
        },
        "reviewer_authority": {
          "const": "falsification_evidence_only"
        },
        "may_raise_claim_ceiling": {
          "const": false
        },
        "applies_to_product_impacting_claims": {
          "const": true
        },
        "status": {
          "enum": [
            "pass",
            "revise",
            "blocked"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/boundArtifact"
        },
        "receipt_generated_at": {
          "type": "string",
          "minLength": 20
        },
        "claim_ids_reviewed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dimensions_checked": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "audience",
              "job",
              "context",
              "outcome",
              "accessibility",
              "cognitive_load",
              "recovery_burden",
              "continuance",
              "real_use_evidence",
              "product_success_substitution_rejection"
            ]
          }
        },
        "substitution_rejection": {
          "const": true
        },
        "generic_product_approval_only": {
          "const": false
        }
      }
    },
    "claimCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "unsupported"
      ],
      "properties": {
        "supported": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimCeilingEntry"
          }
        },
        "unsupported": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimCeilingEntry"
          }
        }
      }
    },
    "reviewerClaimAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "not_disproven",
        "challenged"
      ],
      "properties": {
        "authority": {
          "const": "falsification_only_cannot_raise"
        },
        "not_disproven": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimCeilingEntry"
          }
        },
        "challenged": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimCeilingEntry"
          }
        }
      }
    },
    "claimCeilingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "status",
        "rationale"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counterexampleProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "counterexample",
        "evidence"
      ],
      "properties": {
        "probe_id": {
          "type": "string",
          "minLength": 1
        },
        "counterexample": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/boundArtifact"
        }
      }
    },
    "nextRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repair_id",
        "disposition",
        "evidence"
      ],
      "properties": {
        "repair_id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "none_required",
            "required_before_next_phase"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/boundArtifact"
        }
      }
    },
    "reviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "summary",
        "evidence"
      ],
      "properties": {
        "severity": {
          "enum": [
            "blocker",
            "non_blocking"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
