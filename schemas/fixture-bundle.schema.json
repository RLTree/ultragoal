{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/fixture-bundle.schema.json",
  "title": "Harness Ultragoal Fixture Bundle",
  "type": "object",
  "required": [
    "schema",
    "description",
    "completion_manifest",
    "lane_registry",
    "ready_for_merge",
    "validator_receipt",
    "verification_backlog",
    "amendments",
    "plugin_manifest",
    "automation_tick_receipt"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.fixture-bundle.v1"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "completion_manifest": {
      "$ref": "completion-manifest.schema.json"
    },
    "lane_registry": {
      "$ref": "lane-registry.schema.json"
    },
    "ready_for_merge": {
      "$ref": "ready-for-merge.schema.json"
    },
    "ready_for_merge_receipts": {
      "type": "array",
      "items": {
        "$ref": "ready-for-merge.schema.json"
      }
    },
    "validator_receipt": {
      "$ref": "validator-receipt.schema.json"
    },
    "verification_backlog": {
      "$ref": "verification-backlog.schema.json"
    },
    "amendments": {
      "type": "array",
      "items": {
        "$ref": "contract-amendment.schema.json"
      }
    },
    "plugin_manifest": {
      "$ref": "plugin-manifest.schema.json"
    },
    "automation_tick_receipt": {
      "$ref": "automation-tick-receipt.schema.json"
    }
  },
  "additionalProperties": false
}
