{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/lane-registry.schema.json",
  "title": "Harness Ultragoal Lane Registry",
  "type": "object",
  "required": [
    "schema",
    "goal_id",
    "canonical_authority",
    "lanes",
    "root_verification_stages",
    "generated_at"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.lane-registry.v1"
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_authority": {
      "const": "LANE_REGISTRY.json"
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "lane_type",
          "lane_objective",
          "macro_lane_rationale",
          "acceptance_scope",
          "lane_size_evidence",
          "covered_claim_ids",
          "owner",
          "thread_or_session_id",
          "actor_binding",
          "branch",
          "workspace",
          "execplan",
          "base_commit",
          "current_commit",
          "target_branch",
          "target_head_at_launch",
          "target_head_at_validation",
          "merge_base_at_validation",
          "last_heartbeat",
          "owned_paths",
          "forbidden_paths",
          "state_roots",
          "temporary_state_roots",
          "tool_cache_roots",
          "browser_profile_roots",
          "artifact_root",
          "port_allocations",
          "ready_receipt",
          "claim_ids",
          "dependencies",
          "workspace_status",
          "teardown"
        ],
        "properties": {
          "id": {
            "$ref": "schema-authority-primitives.schema.json#/$defs/laneId"
          },
          "status": {
            "enum": [
              "planned",
              "active",
              "blocked",
              "ready_for_review",
              "merged",
              "superseded",
              "abandoned",
              "complete"
            ]
          },
          "lane_type": {
            "enum": [
              "implementation",
              "verification",
              "orchestration",
              "parent_owned"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "thread_or_session_id": {
            "type": "string",
            "minLength": 1
          },
          "actor_binding": {
            "type": "object",
            "required": [
              "actor_id",
              "thread_or_session_id",
              "launch_receipt",
              "latest_heartbeat_receipt",
              "actor_status",
              "validated_at"
            ],
            "properties": {
              "actor_id": {
                "type": "string",
                "minLength": 1
              },
              "thread_or_session_id": {
                "type": "string",
                "minLength": 1
              },
              "launch_receipt": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
              },
              "latest_heartbeat_receipt": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
              },
              "actor_status": {
                "enum": [
                  "current",
                  "stale",
                  "superseded",
                  "archived"
                ]
              },
              "validated_at": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
              }
            },
            "additionalProperties": false
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "workspace": {
            "type": "string",
            "minLength": 1
          },
          "execplan": {
            "type": "string",
            "minLength": 1
          },
          "base_commit": {
            "type": "string",
            "minLength": 7
          },
          "current_commit": {
            "type": "string",
            "minLength": 7
          },
          "target_branch": {
            "type": "string",
            "minLength": 1
          },
          "target_head_at_launch": {
            "type": "string",
            "minLength": 7
          },
          "target_head_at_validation": {
            "type": "string",
            "minLength": 7
          },
          "merge_base_at_validation": {
            "type": "string",
            "minLength": 7
          },
          "target_freshness": {
            "type": "object",
            "required": [
              "target_head_matches_live",
              "merge_base_includes_target_head",
              "checked_at",
              "live_target_receipt"
            ],
            "properties": {
              "target_head_matches_live": {
                "type": "boolean"
              },
              "merge_base_includes_target_head": {
                "type": "boolean"
              },
              "checked_at": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
              },
              "stale_reason": {
                "type": "string"
              },
              "live_target_receipt": {
                "type": "object",
                "required": [
                  "command",
                  "observed_target_head",
                  "observed_merge_base",
                  "observed_workspace",
                  "observed_branch"
                ],
                "properties": {
                  "command": {
                    "$ref": "schema-authority-primitives.schema.json#/$defs/commandReceipt"
                  },
                  "observed_target_head": {
                    "type": "string",
                    "minLength": 7
                  },
                  "observed_merge_base": {
                    "type": "string",
                    "minLength": 7
                  },
                  "observed_workspace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observed_branch": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "last_heartbeat": {
            "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
          },
          "owned_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "forbidden_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "state_roots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "temporary_state_roots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "tool_cache_roots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "browser_profile_roots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifact_root": {
            "type": "string",
            "minLength": 1
          },
          "port_allocations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "port"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "additionalProperties": false
            }
          },
          "ready_receipt": {
            "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "schema-authority-primitives.schema.json#/$defs/claimId"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "upstream_lane_id",
                "claim_id",
                "required_status",
                "validated_status",
                "upstream_ready_receipt",
                "evidence_digest",
                "upstream_commit",
                "validated_after_upstream_ready",
                "validated_at"
              ],
              "properties": {
                "upstream_lane_id": {
                  "$ref": "schema-authority-primitives.schema.json#/$defs/laneId"
                },
                "claim_id": {
                  "$ref": "schema-authority-primitives.schema.json#/$defs/claimId"
                },
                "required_status": {
                  "$ref": "schema-authority-primitives.schema.json#/$defs/positiveClaimStatus"
                },
                "validated_status": {
                  "$ref": "schema-authority-primitives.schema.json#/$defs/positiveClaimStatus"
                },
                "upstream_ready_receipt": {
                  "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
                },
                "evidence_digest": {
                  "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
                },
                "upstream_commit": {
                  "type": "string",
                  "minLength": 7
                },
                "validated_after_upstream_ready": {
                  "const": true
                },
                "validated_at": {
                  "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
                }
              },
              "additionalProperties": false
            }
          },
          "dependency_release": {
            "type": "object",
            "required": [
              "action",
              "downstream_lane_id",
              "upstream_lane_id",
              "claim_id",
              "post_merge_receipt",
              "decided_at",
              "actor_id",
              "thread_or_session_id",
              "reason"
            ],
            "properties": {
              "action": {
                "enum": [
                  "launch",
                  "resume",
                  "reblock"
                ]
              },
              "downstream_lane_id": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/laneId"
              },
              "upstream_lane_id": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/laneId"
              },
              "claim_id": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/claimId"
              },
              "post_merge_receipt": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
              },
              "decided_at": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
              },
              "actor_id": {
                "type": "string",
                "minLength": 1
              },
              "thread_or_session_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 20
              },
              "blocker": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "owner",
                  "reason",
                  "affected_claim_ids"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 20
                  },
                  "affected_claim_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "schema-authority-primitives.schema.json#/$defs/claimId"
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          },
          "workspace_status": {
            "type": "object",
            "required": [
              "clean",
              "status_receipt",
              "status_command_receipt",
              "observed_clean",
              "observed_workspace",
              "observed_branch",
              "observed_head",
              "dirty_paths"
            ],
            "properties": {
              "clean": {
                "type": "boolean"
              },
              "status_receipt": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
              },
              "preserved_dirty_paths": {
                "type": "array",
                "items": {
                  "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
                }
              },
              "status_command_receipt": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/commandReceipt"
              },
              "observed_clean": {
                "type": "boolean"
              },
              "observed_workspace": {
                "type": "string",
                "minLength": 1
              },
              "observed_branch": {
                "type": "string",
                "minLength": 1
              },
              "observed_head": {
                "type": "string",
                "minLength": 7
              },
              "dirty_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "teardown": {
            "type": "object",
            "required": [
              "required",
              "status"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "not_ready",
                  "ready",
                  "complete",
                  "preserved_with_reason"
                ]
              },
              "reason": {
                "type": "string"
              },
              "receipt": {
                "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
              },
              "cleanup_receipts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "schema-authority-primitives.schema.json#/$defs/cleanupReceipt"
                }
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "preserved_with_reason"
                    }
                  }
                },
                "then": {
                  "required": [
                    "reason",
                    "cleanup_receipts"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "complete"
                    }
                  }
                },
                "then": {
                  "required": [
                    "cleanup_receipts"
                  ]
                }
              }
            ]
          },
          "lane_objective": {
            "type": "string",
            "minLength": 20
          },
          "macro_lane_rationale": {
            "type": "string",
            "minLength": 40
          },
          "acceptance_scope": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lane_size_evidence": {
            "type": "object",
            "required": [
              "independent_outcome",
              "owned_path_groups",
              "work_units",
              "why_not_parent_inline",
              "why_not_smaller"
            ],
            "properties": {
              "independent_outcome": {
                "type": "string",
                "minLength": 40
              },
              "owned_path_groups": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "work_units": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "why_not_parent_inline": {
                "type": "string",
                "minLength": 30
              },
              "why_not_smaller": {
                "type": "string",
                "minLength": 30
              }
            },
            "additionalProperties": false
          },
          "split_amendment_ref": {
            "type": "string"
          },
          "covered_claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "schema-authority-primitives.schema.json#/$defs/claimId"
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "ready_for_review",
                    "merged",
                    "complete"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "target_freshness"
              ],
              "properties": {
                "actor_binding": {
                  "properties": {
                    "actor_status": {
                      "const": "current"
                    }
                  }
                },
                "target_freshness": {
                  "properties": {
                    "target_head_matches_live": {
                      "const": true
                    },
                    "merge_base_includes_target_head": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "merged",
                    "complete",
                    "superseded",
                    "abandoned"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "teardown": {
                  "properties": {
                    "status": {
                      "enum": [
                        "complete",
                        "preserved_with_reason"
                      ]
                    }
                  }
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "workspace_status": {
                      "properties": {
                        "clean": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "workspace_status": {
                      "required": [
                        "preserved_dirty_paths"
                      ],
                      "properties": {
                        "preserved_dirty_paths": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "root_verification_stages": {
      "type": "object",
      "required": [
        "pre_merge_lane_gate",
        "post_merge_integration_gate",
        "final_all_lanes_gate"
      ],
      "properties": {
        "pre_merge_lane_gate": {
          "$ref": "#/$defs/rootPhasePreMerge"
        },
        "post_merge_integration_gate": {
          "$ref": "#/$defs/rootPhasePostMerge"
        },
        "final_all_lanes_gate": {
          "$ref": "#/$defs/rootPhaseFinal"
        }
      },
      "additionalProperties": false
    },
    "generated_at": {
      "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rootPhaseBase": {
      "type": "object",
      "required": [
        "stage",
        "status",
        "trigger",
        "owner",
        "required_inputs",
        "blocking",
        "claim_ceiling_impact"
      ],
      "properties": {
        "stage": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/rootVerificationPhase"
        },
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail",
            "blocked"
          ]
        },
        "trigger": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command_receipt": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/commandReceipt"
        },
        "artifact_receipt": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
        },
        "blocking": {
          "type": "boolean"
        },
        "claim_ceiling_impact": {
          "type": "string"
        },
        "validated_at": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            }
          },
          "then": {
            "required": [
              "command_receipt",
              "artifact_receipt",
              "validated_at"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "rootPhasePreMerge": {
      "allOf": [
        {
          "$ref": "#/$defs/rootPhaseBase"
        },
        {
          "properties": {
            "stage": {
              "const": "pre_merge_lane_gate"
            }
          }
        }
      ]
    },
    "rootPhasePostMerge": {
      "allOf": [
        {
          "$ref": "#/$defs/rootPhaseBase"
        },
        {
          "properties": {
            "stage": {
              "const": "post_merge_integration_gate"
            }
          }
        }
      ]
    },
    "rootPhaseFinal": {
      "allOf": [
        {
          "$ref": "#/$defs/rootPhaseBase"
        },
        {
          "properties": {
            "stage": {
              "const": "final_all_lanes_gate"
            }
          }
        }
      ]
    }
  }
}
