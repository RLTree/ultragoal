{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/lane-registry.schema.json",
  "title": "Harness Ultragoal canonical successor lane registry",
  "type": "object",
  "required": ["$schema", "schema", "checkpoint", "goal_id", "canonical_authority", "authority_mode", "root", "goal_binding", "source_context", "defaults", "state_policy", "lanes", "tombstones", "generated_at"],
  "properties": {
    "$schema": {"const": "schemas/lane-registry.schema.json"},
    "schema": {"const": "harness-ultragoal.lane-registry.v2"},
    "checkpoint": {"const": "V8.1-canonical-state"},
    "goal_id": {"type": "string", "minLength": 1},
    "canonical_authority": {"const": "LANE_REGISTRY.json"},
    "authority_mode": {"const": "single_root_writer_single_successor_registry"},
    "root": {"$ref": "#/$defs/root"},
    "goal_binding": {"$ref": "#/$defs/goalBinding"},
    "source_context": {"$ref": "#/$defs/sourceContext"},
    "defaults": {"$ref": "#/$defs/defaults"},
    "state_policy": {"$ref": "#/$defs/statePolicy"},
    "lanes": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"$ref": "#/$defs/lane"}},
    "tombstones": {"type": "array", "items": {"$ref": "#/$defs/tombstone"}},
    "generated_at": {"$ref": "#/$defs/isoTimestamp"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "isoTimestamp": {"type": "string", "format": "date-time"},
    "goalBinding": {
      "type": "object",
      "required": ["status", "goal_id", "objective", "contract_path", "checked_at", "gap_reason", "discovery_probe_receipt"],
      "properties": {
        "status": {"enum": ["bound", "unavailable", "blocked"]}, "goal_id": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "contract_path": {"type": "string", "minLength": 1}, "checked_at": {"$ref": "#/$defs/isoTimestamp"}, "gap_reason": {"type": "string", "minLength": 1},
        "discovery_probe_receipt": {
          "type": "object", "required": ["tool_surface", "attempted_tools", "verdict", "actor_id", "workspace", "output", "checked_at"],
          "properties": {"tool_surface": {"type": "string", "minLength": 1}, "attempted_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["get_goal", "create_goal", "update_goal", "automation_update", "create_thread"]}}, "verdict": {"enum": ["available", "unavailable", "blocked"]}, "actor_id": {"type": "string", "minLength": 1}, "workspace": {"type": "string", "minLength": 1}, "output": {"type": "object", "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}, "checked_at": {"$ref": "#/$defs/isoTimestamp"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "laneId": {"type": "string", "pattern": "^N(0[0-9]|1[0-7])$"},
    "state": {"enum": ["planned", "ready", "leased", "candidate", "under_review", "rework", "accepted", "integrating", "integrated", "blocked", "superseded"]},
    "ref": {
      "type": "object",
      "required": ["path", "digest", "validity", "invalidation"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/sha256"},
        "validity": {"enum": ["current_exact", "historical_nonselectable"]},
        "invalidation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/sha256"}, "role": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "consumedCategory": {
      "type": "object",
      "required": ["status", "digest", "entries"],
      "properties": {"status": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/sha256"}, "entries": {"type": "array"}},
      "additionalProperties": false
    },
    "consumedSet": {
      "type": "object",
      "required": ["files", "symbols", "generated", "fixtures", "effects", "forbidden", "tools", "contract", "context"],
      "properties": {
        "files": {"$ref": "#/$defs/consumedCategory"}, "symbols": {"$ref": "#/$defs/consumedCategory"}, "generated": {"$ref": "#/$defs/consumedCategory"},
        "fixtures": {"$ref": "#/$defs/consumedCategory"}, "effects": {"$ref": "#/$defs/consumedCategory"}, "forbidden": {"$ref": "#/$defs/consumedCategory"},
        "tools": {"$ref": "#/$defs/consumedCategory"}, "contract": {"$ref": "#/$defs/consumedCategory"}, "context": {"$ref": "#/$defs/consumedCategory"}
      },
      "additionalProperties": false
    },
    "claimCeiling": {
      "type": "object",
      "required": ["effect", "supported_surfaces", "withheld_claims"],
      "properties": {"effect": {"const": "withheld"}, "supported_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "withheld_claims": {"type": "array", "minItems": 14, "items": {"type": "string", "pattern": "^CL-[A-Z0-9-]+$"}}},
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "required": ["branch", "workspace", "base_commit", "base_tree", "workspace_status", "observed_at", "dirty_inventory", "observation"],
      "properties": {
        "branch": {"type": "string", "minLength": 1}, "workspace": {"type": "string", "minLength": 1}, "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "base_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "workspace_status": {"const": "dirty"}, "observed_at": {"$ref": "#/$defs/isoTimestamp"},
        "dirty_inventory": {"type": "object", "required": ["owned", "root_owned", "foreign"], "properties": {"owned": {"type": "array", "minItems": 5, "items": {"type": "string"}}, "root_owned": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "foreign": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
        "observation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sourceContext": {
      "type": "object",
      "required": ["board", "dependency_graph", "custom_tool_inventory", "claim_registry", "contract", "selection_rule"],
      "properties": {"board": {"$ref": "#/$defs/sourceRef"}, "dependency_graph": {"$ref": "#/$defs/sourceRef"}, "custom_tool_inventory": {"$ref": "#/$defs/sourceRef"}, "claim_registry": {"$ref": "#/$defs/sourceRef"}, "contract": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/sourceRef"}}, "selection_rule": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "required": ["consumed_set", "claim_ceiling", "branch", "worktree", "execplan"],
      "properties": {"consumed_set": {"$ref": "#/$defs/consumedSet"}, "claim_ceiling": {"$ref": "#/$defs/claimCeiling"}, "branch": {"type": "string", "minLength": 1}, "worktree": {"type": "string", "minLength": 1}, "execplan": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "statePolicy": {
      "type": "object",
      "required": ["allowed_states", "active_lane_ids", "canonical_writer", "projection_writers", "claim_decision_authority", "epoch_policy", "projection_binding", "root_blockers"],
      "properties": {
        "allowed_states": {"type": "array", "minItems": 11, "uniqueItems": true, "items": {"$ref": "#/$defs/state"}},
        "active_lane_ids": {"type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": {"$ref": "#/$defs/laneId"}},
        "canonical_writer": {"const": "root"}, "projection_writers": {"type": "object", "required": ["VERIFICATION_BACKLOG.json", "COMPLETION_MANIFEST.json"], "properties": {"VERIFICATION_BACKLOG.json": {"const": "root"}, "COMPLETION_MANIFEST.json": {"const": "root"}}, "additionalProperties": false},
        "claim_decision_authority": {"type": "object", "required": ["writer_lane", "tool", "read_only_consumers"], "properties": {"writer_lane": {"const": "N12"}, "tool": {"const": "HCT-CLAIMS"}, "read_only_consumers": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["N13", "N15", "N16", "N17"]}}}, "additionalProperties": false},
        "epoch_policy": {"type": "string", "minLength": 1}, "projection_binding": {"type": "object", "required": ["base_commit", "base_tree", "finalization"], "properties": {"base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "base_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "finalization": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "root_blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "lane": {
      "type": "object",
      "required": ["id", "state", "board_ref", "owner", "objective", "current_state", "blocker", "dependencies", "authored_dependencies", "candidate_refs", "acceptance_refs", "required_hct_tools", "consumed_set", "claim_ceiling", "next_action", "branch", "worktree", "execplan", "epochs", "claim_role"],
      "properties": {
        "id": {"$ref": "#/$defs/laneId"}, "state": {"$ref": "#/$defs/state"}, "board_ref": {"const": "source_context.board"}, "owner": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "current_state": {"type": "string", "minLength": 1}, "blocker": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/laneId"}}, "authored_dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/laneId"}}, "candidate_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "acceptance_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "required_hct_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^HCT-[A-Z-]+$"}}, "consumed_set": {"const": "defaults.consumed_set"}, "claim_ceiling": {"const": "defaults.claim_ceiling"}, "next_action": {"type": "string", "minLength": 1}, "branch": {"type": ["string", "null"]}, "worktree": {"type": ["string", "null"]}, "execplan": {"type": ["string", "null"]},
        "epochs": {"type": "object", "required": ["source", "live", "dag_edge_added"], "properties": {"source": {"type": "string", "minLength": 1}, "live": {"type": "string", "minLength": 1}, "dag_edge_added": {"const": false}, "note": {"type": "string"}}, "additionalProperties": false}, "claim_role": {"enum": ["none", "decision_writer", "read_only_reconciliation_consumer"]}
      },
      "additionalProperties": false
    },
    "tombstone": {"type": "object", "required": ["id", "kind", "identity", "selection", "reason"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "identity": {"type": "object"}, "selection": {"enum": ["never", "history_only"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  }
}
