      "properties": {"state": {"const": "blocked"}, "lease_status": {"const": "unissued"}, "lease_record": {"const": null}, "claim_ceiling": {"const": "withheld"}, "epoch": {"const": "PRE-ADOPTION-SOURCE"}, "consumed": {"$ref": "#/$defs/consumed"}}
