      "allOf": [{"if": {"properties": {"status": {"const": "unavailable"}}}, "then": {"properties": {"digest": {"type": "null"}}}}, {"if": {"properties": {"status": {"const": "current"}}}, "then": {"properties": {"digest": {"$ref": "#/$defs/sha256"}}}}]
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["template_ref", "round_id", "reviewer_ids", "fresh_reviewers", "candidate", "anchors", "status", "claim_ceiling"],
      "properties": {"template_ref": {"type": "string", "minLength": 1}, "round_id": {"type": "string", "minLength": 1}, "reviewer_ids": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "fresh_reviewers": {"const": true}, "candidate": {"$ref": "#/$defs/candidate"}, "anchors": {"type": "object", "additionalProperties": false, "required": ["validator", "review_target", "archive", "prompt", "schema", "structured_output"], "properties": {"validator": {"$ref": "#/$defs/anchor"}, "review_target": {"$ref": "#/$defs/anchor"}, "archive": {"$ref": "#/$defs/anchor"}, "prompt": {"$ref": "#/$defs/anchor"}, "schema": {"$ref": "#/$defs/anchor"}, "structured_output": {"$ref": "#/$defs/anchor"}}}, "status": {"const": "blocked"}, "claim_ceiling": {"const": "withheld"}}
    },
    "lane": {
      "type": "object", "additionalProperties": false, "required": ["id", "owner", "state", "dependencies", "scope_ids", "authority"],
      "properties": {"id": {"$ref": "#/$defs/lane_id"}, "owner": {"type": "string", "minLength": 1}, "state": {"const": "blocked"}, "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/lane_id"}}, "scope_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "authority": {"enum": ["lane_write", "root_only", "read_only"]}},
      "allOf": [{"if": {"properties": {"authority": {"const": "root_only"}}}, "then": {"properties": {"scope_ids": {"maxItems": 0}}}}, {"if": {"properties": {"authority": {"const": "read_only"}}}, "then": {"properties": {"scope_ids": {"minItems": 2}}}}, {"if": {"properties": {"authority": {"const": "lane_write"}}}, "then": {"properties": {"scope_ids": {"minItems": 1}}}}]
    },
    "historical_ref": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"validity": {"const": "historical_nonselectable"}, "invalidation": {"const": "never_selectable"}}}]},
    "pre_adoption": {
      "type": "object", "additionalProperties": false, "required": ["epoch", "dag_node", "contract_ref", "contract_bundle_ref", "historical_ref", "adoption_rule"],
      "properties": {"epoch": {"const": "PRE-ADOPTION-SOURCE"}, "dag_node": {"const": false}, "contract_ref": {"$ref": "#/$defs/current_ref"}, "contract_bundle_ref": {"$ref": "#/$defs/current_ref"}, "historical_ref": {"$ref": "#/$defs/historical_ref"}, "adoption_rule": {"type": "string", "minLength": 1}}
    },
    "tombstone": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "identity", "selection"],
      "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "identity": {"$ref": "#/$defs/tombstone_identity"}, "selection": {"const": "history_only"}}
    },
    "tombstone_identity": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"branches": {"type": "array", "items": {"type": "string"}}, "branch": {"type": "string"}, "paths": {"type": "array", "items": {"type": "string"}}, "path": {"type": "string"}, "commit": {"$ref": "#/$defs/hex40"}, "digest": {"$ref": "#/$defs/sha256"}, "validity": {"const": "historical_nonselectable"}}
    }
  }
}
