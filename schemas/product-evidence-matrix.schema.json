{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/product-evidence-matrix.schema.json",
  "title": "product-evidence-matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_ids",
    "evidence_rows",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.product-evidence-matrix.v1"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
