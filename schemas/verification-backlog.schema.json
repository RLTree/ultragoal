{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/verification-backlog.schema.json",
  "title": "Harness Ultragoal Verification Backlog",
  "type": "object",
  "required": [
    "schema",
    "manifest_digest",
    "registry_preimage_digest",
    "audit_cadence",
    "rows",
    "generated_at"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.verification-backlog.v1"
    },
    "manifest_digest": {
      "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
    },
    "registry_preimage_digest": {
      "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
    },
    "audit_cadence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audit", "trigger", "owner", "candidate_identity", "evidence_surface", "claims_withheld"],
        "properties": {
          "audit": {"enum": ["lane_freeze", "root_integration", "product_freeze", "release_completion"]},
          "trigger": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "candidate_identity": {"const": "clean current HEAD/tree derived from LANE_REGISTRY.json protected base"},
          "evidence_surface": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "claims_withheld": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim_id",
          "class",
          "owner",
          "required_proof",
          "blocker_type",
          "attempts",
          "next_action",
          "claim_ceiling_impact",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BACKLOG-[0-9]{3,}$"
          },
          "claim_id": {
            "$ref": "schema-authority-primitives.schema.json#/$defs/claimId"
          },
          "class": {
            "enum": [
              "lane_owed",
              "root_owed",
              "externally_blocked",
              "withheld_claim"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "required_proof": {
            "type": "string",
            "minLength": 1
          },
          "blocker_type": {
            "enum": [
              "auth",
              "credential",
              "missing_artifact",
              "install_or_provisioning",
              "root_integration_needed",
              "package_or_installed_surface_needed",
              "product_decision",
              "external_state",
              "claim_withheld"
            ]
          },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "schema-authority-primitives.schema.json#/$defs/attempt"
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "claim_ceiling_impact": {
            "enum": [
              "degraded",
              "blocked",
              "withheld"
            ]
          },
          "evidence": {
            "$ref": "schema-authority-primitives.schema.json#/$defs/artifactRef"
          }
        },
        "additionalProperties": false
      }
    },
    "generated_at": {
      "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
    }
  },
  "additionalProperties": false
}
