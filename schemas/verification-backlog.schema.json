{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/verification-backlog.schema.json",
  "title": "Harness Ultragoal Verification Backlog",
  "type": "object",
  "required": [
    "schema",
    "manifest_digest",
    "rows",
    "generated_at"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.verification-backlog.v1"
    },
    "manifest_digest": {
      "$ref": "common-defs.schema.json#/$defs/sha256"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim_id",
          "class",
          "owner",
          "required_proof",
          "blocker_type",
          "attempts",
          "next_action",
          "claim_ceiling_impact",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BACKLOG-[0-9]{3,}$"
          },
          "claim_id": {
            "$ref": "common-defs.schema.json#/$defs/claimId"
          },
          "class": {
            "enum": [
              "lane_owed",
              "root_owed",
              "externally_blocked",
              "withheld_claim"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "required_proof": {
            "type": "string",
            "minLength": 1
          },
          "blocker_type": {
            "enum": [
              "auth",
              "credential",
              "missing_artifact",
              "install_or_provisioning",
              "root_integration_needed",
              "package_or_installed_surface_needed",
              "product_decision",
              "external_state",
              "claim_withheld"
            ]
          },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common-defs.schema.json#/$defs/attempt"
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "claim_ceiling_impact": {
            "enum": [
              "degraded",
              "blocked",
              "withheld"
            ]
          },
          "evidence": {
            "$ref": "common-defs.schema.json#/$defs/artifactRef"
          }
        },
        "additionalProperties": false
      }
    },
    "generated_at": {
      "$ref": "common-defs.schema.json#/$defs/isoTimestamp"
    }
  },
  "additionalProperties": false
}
