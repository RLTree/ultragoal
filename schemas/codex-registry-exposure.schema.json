{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/codex-registry-exposure.schema.json",
  "title": "Codex Active Custom Agent Registry Exposure Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "captured_at",
    "status",
    "issuer",
    "tool_call",
    "capture_method",
    "boundary",
    "source",
    "target_revision",
    "claim_ceiling",
    "session_id",
    "round_id",
    "raw_observation",
    "agent_types"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.multi-agent-registry-exposure.v1"
    },
    "captured_at": {
      "type": "string",
      "minLength": 20
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "authority"
      ],
      "properties": {
        "tool": {
          "enum": [
            "multi_agent_v1",
            "ultragoal",
            "codex_desktop",
            "computer_use"
          ]
        },
        "authority": {
          "enum": [
            "tool_registry",
            "cli_control_plane",
            "tool_discovery",
            "app_surface_probe"
          ]
        }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "call_id",
        "arguments_digest"
      ],
      "properties": {
        "name": {
          "enum": [
            "multi_agent_v1.tool_registry",
            "ultragoal registry probe",
            "tool_search_tool",
            "computer_use.list_apps"
          ]
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "arguments_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "capture_method": {
      "enum": [
        "live_tool_registry_query",
        "fail_closed_no_capability",
        "tool_discovery_probe",
        "computer_use_probe_timeout"
      ]
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "workspace_id",
        "session_id"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "enum": [
        "multi_agent_v1.tool_registry",
        "ultragoal.registry_probe",
        "codex_desktop.tool_search",
        "computer_use.list_apps"
      ]
    },
    "target_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "package_digest"
        },
        "value": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "claim_ceiling": {
      "enum": [
        "live_registry_reviewer_exposure_proven",
        "withheld_or_blocked"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "round_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^validation_artifacts/ultragoal-audit/[-A-Za-z0-9._/]+[.]json$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "capability_gap": {
      "$ref": "#/$defs/capabilityGap"
    },
    "agent_types": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/agentTypeExposure"
      }
    },
    "failure": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "reason",
        "observed",
        "blocked_claim_classes"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "blocked_claim_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "issuer": {
            "properties": {
              "tool": {
                "const": "multi_agent_v1"
              },
              "authority": {
                "const": "tool_registry"
              }
            }
          },
          "tool_call": {
            "properties": {
              "name": {
                "const": "multi_agent_v1.tool_registry"
              }
            }
          },
          "capture_method": {
            "const": "live_tool_registry_query"
          },
          "source": {
            "const": "multi_agent_v1.tool_registry"
          },
          "claim_ceiling": {
            "const": "live_registry_reviewer_exposure_proven"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "failure",
          "capability_gap"
        ],
        "properties": {
          "claim_ceiling": {
            "const": "withheld_or_blocked"
          },
          "failure": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "artifactAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "capabilityGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "source_artifact",
        "source_session_id",
        "observed_at",
        "affected_workflow",
        "affected_law_ids",
        "affected_claim_ids",
        "missing_capability_class",
        "owner_surface",
        "blocked_package_surfaces",
        "deterministic_repair_target",
        "chosen_promotion_artifact",
        "current_claim_ceiling",
        "required_evidence",
        "disposition"
      ],
      "properties": {
        "schema": {
          "const": "harness-ultragoal.capability-gap.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact": {
          "$ref": "#/$defs/artifactAnchor"
        },
        "source_session_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "minLength": 20
        },
        "affected_workflow": {
          "const": "registry_probe"
        },
        "affected_law_ids": {
          "type": "array",
          "minItems": 3,
          "items": {
            "enum": [
              "capability-gap-extraction-harness-capability-promotion",
              "connector-capability-discovery",
              "distribution-sharing-surface-claim-separation"
            ]
          },
          "uniqueItems": true
        },
        "affected_claim_ids": {
          "type": "array",
          "minItems": 5,
          "items": {
            "enum": [
              "app_registry_or_reviewer_exposure",
              "review_readiness",
              "release_readiness",
              "completion",
              "update_goal_eligibility"
            ]
          },
          "uniqueItems": true
        },
        "missing_capability_class": {
          "const": "live_same_surface_plugin_registry_or_reviewer_exposure"
        },
        "owner_surface": {
          "const": "codex_desktop_plugin_registry"
        },
        "blocked_package_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deterministic_repair_target": {
          "const": "provide_live_tool_registry_query_or_keep_claims_blocked"
        },
        "chosen_promotion_artifact": {
          "const": "validation_artifacts/ultragoal-audit/active-registry-exposure-current.json"
        },
        "current_claim_ceiling": {
          "const": "withheld_or_blocked"
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disposition": {
          "const": "open_claim_blocked"
        }
      }
    },
    "agentTypeExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_type",
        "persona",
        "custom_agent_path",
        "disk_cache_synced",
        "global_toml_present",
        "exposed"
      ],
      "properties": {
        "agent_type": {
          "type": "string",
          "minLength": 1
        },
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "custom_agent_path": {
          "type": "string",
          "pattern": "^custom-agents/harness-[a-z-]+\\.toml$"
        },
        "disk_cache_synced": {
          "type": "boolean"
        },
        "global_toml_present": {
          "type": "boolean"
        },
        "exposed": {
          "type": "boolean"
        }
      }
    }
  }
}
