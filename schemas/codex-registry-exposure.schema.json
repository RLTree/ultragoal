{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/codex-registry-exposure.schema.json",
  "title": "Codex Active Custom Agent Registry Exposure Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "captured_at",
    "status",
    "issuer",
    "tool_call",
    "capture_method",
    "boundary",
    "source",
    "target_revision",
    "claim_ceiling",
    "session_id",
    "round_id",
    "raw_observation",
    "agent_types"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.multi-agent-registry-exposure.v1"
    },
    "captured_at": {
      "type": "string",
      "minLength": 20
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "const": "pass"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "authority"
      ],
      "properties": {
        "tool": {
          "const": "multi_agent_v1"
        },
        "authority": {
          "const": "tool_registry"
        }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "call_id",
        "arguments_digest"
      ],
      "properties": {
        "name": {
          "const": "multi_agent_v1.tool_registry"
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "arguments_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "capture_method": {
      "const": "live_tool_registry_query"
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "workspace_id",
        "session_id"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "const": "multi_agent_v1.tool_registry"
    },
    "target_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "package_digest"
        },
        "value": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "claim_ceiling": {
      "const": "live_registry_reviewer_exposure_proven"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "round_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^validation_artifacts/ultragoal-audit/[-A-Za-z0-9._/]+[.]json$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "agent_types": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/agentTypeExposure"
      }
    }
  },
  "$defs": {
    "agentTypeExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_type",
        "persona",
        "custom_agent_path",
        "disk_cache_synced",
        "global_toml_present",
        "exposed"
      ],
      "properties": {
        "agent_type": {
          "type": "string",
          "minLength": 1
        },
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "custom_agent_path": {
          "type": "string",
          "pattern": "^custom-agents/harness-[a-z-]+\\.toml$"
        },
        "disk_cache_synced": {
          "type": "boolean"
        },
        "global_toml_present": {
          "type": "boolean"
        },
        "exposed": {
          "type": "boolean"
        }
      }
    }
  }
}
