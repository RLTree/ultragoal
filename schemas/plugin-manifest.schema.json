{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/plugin-manifest.schema.json",
  "title": "Harness Ultragoal Plugin Manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "status",
    "purpose",
    "skills",
    "agents",
    "authorable_templates",
    "generated_examples",
    "schemas",
    "fixtures",
    "optional_connectors",
    "non_goals",
    "schema_catalog",
    "resources"
  ],
  "properties": {
    "name": {
      "const": "harness-ultragoal"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposal",
        "implementation",
        "released"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
  "type": "array",
  "minItems": 8,
  "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true,
  "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "harness-ultragoal"
              },
              "path": {
                "const": "skills/harness-ultragoal/SKILL.md"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "repository-fit"
              },
              "path": {
                "const": "skills/repository-fit/SKILL.md"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "routine-work"
              },
              "path": {
                "const": "skills/routine-work/SKILL.md"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "diagnose-and-observe"
              },
              "path": {
                "const": "skills/diagnose-and-observe/SKILL.md"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "goal-run"
              },
              "path": {
                "const": "skills/goal-run/SKILL.md"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "product-journey-review"
              },
              "path": {
                "const": "skills/product-journey-review/SKILL.md"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "prove"
              },
              "path": {
                "const": "skills/prove/SKILL.md"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "improve-and-maintain"
              },
              "path": {
                "const": "skills/improve-and-maintain/SKILL.md"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        }
      ],
      "not": {
        "contains": {
          "properties": {
            "name": {
              "enum": [
                "agent-first-repo-init",
                "agent-first-repo-retrofit",
                "agent-improvement-loop",
                "agent-observability-stack",
                "agent-runtime-legibility",
                "execplan-lane",
                "fit-repo",
                "harness-engineering",
                "orchestrator-reconciler",
                "product-cohesion-gate",
                "product-fitness-gate",
                "proof-gate",
                "standards-gardener",
                "ultragoal"
              ]
            }
          },
          "required": ["name"]
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "app_visible_name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "claim-falsifier"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "orchestration-recovery-reviewer"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "security-reviewer"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "product-journey-reviewer"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "repo-recon"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "research-verifier"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "claim-falsifier"
              },
              "path": {
                "const": ".codex/agents/claim-falsifier.toml"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "orchestration-recovery-reviewer"
              },
              "path": {
                "const": ".codex/agents/orchestration-recovery-reviewer.toml"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "security-reviewer"
              },
              "path": {
                "const": ".codex/agents/security-reviewer.toml"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "product-journey-reviewer"
              },
              "path": {
                "const": ".codex/agents/product-journey-reviewer.toml"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "repo-recon"
              },
              "path": {
                "const": ".codex/agents/repo-recon.toml"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "research-verifier"
              },
              "path": {
                "const": ".codex/agents/research-verifier.toml"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        }
      ],
      "uniqueItems": true
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "optional_connectors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "schema_catalog": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "authorable_templates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "not": {
          "pattern": "(^examples/generated/|READY_FOR_MERGE|VALIDATOR_RECEIPT)"
        }
      },
      "minItems": 10,
      "allOf": [
        {
          "contains": {
            "const": "templates/AGENTS.md"
          }
        },
        {
          "contains": {
            "const": "templates/AGENT_STANDARDS.md"
          }
        },
        {
          "contains": {
            "const": "templates/PLANS.md"
          }
        },
        {
          "contains": {
            "const": "templates/GOAL_CONTRACT.md"
          }
        },
        {
          "contains": {
            "const": "templates/LANE_REGISTRY.json"
          }
        },
        {
          "contains": {
            "const": "templates/LANE_EXECPLAN.md"
          }
        },
        {
          "contains": {
            "const": "templates/COMPLETION_MANIFEST.json"
          }
        },
        {
          "contains": {
            "const": "templates/VERIFICATION_BACKLOG.json"
          }
        },
        {
          "contains": {
            "const": "templates/AMENDMENTS.jsonl"
          }
        },
        {
          "contains": {
            "const": "templates/RED_FIXTURES.json"
          }
        },
        {
          "contains": {
            "const": "templates/ARCHITECTURE.md"
          }
        },
        {
          "contains": {
            "const": "templates/DESIGN.md"
          }
        },
        {
          "contains": {
            "const": "templates/FRONTEND.md"
          }
        },
        {
          "contains": {
            "const": "templates/PRODUCT_SENSE.md"
          }
        },
        {
          "contains": {
            "const": "templates/QUALITY_SCORE.md"
          }
        },
        {
          "contains": {
            "const": "templates/RELIABILITY.md"
          }
        },
        {
          "contains": {
            "const": "templates/SECURITY.md"
          }
        },
        {
          "contains": {
            "const": "templates/docs/design-docs/index.md"
          }
        },
        {
          "contains": {
            "const": "templates/docs/design-docs/core-beliefs.md"
          }
        },
        {
          "contains": {
            "const": "templates/docs/exec-plans/tech-debt-tracker.md"
          }
        },
        {
          "contains": {
            "const": "templates/docs/generated/index.md"
          }
        },
        {
          "contains": {
            "const": "templates/docs/product-specs/index.md"
          }
        },
        {
          "contains": {
            "const": "templates/docs/references/index.md"
          }
        }
      ]
    },
    "generated_examples": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^examples/generated/"
      },
      "minItems": 1,
      "allOf": [
        {
          "contains": {
            "const": "examples/generated/READY_FOR_MERGE.example.json"
          }
        }
      ]
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "custom_agents"
        ]
      },
      {
        "required": [
          "templates"
        ]
      }
    ]
  },
  "additionalProperties": false
}
