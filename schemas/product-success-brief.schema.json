{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/product-success-brief.schema.json",
  "title": "product-success-brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product_success_contract_id",
    "claim_ids",
    "target_problem",
    "audience",
    "job_to_be_done",
    "context_of_use",
    "desired_outcome",
    "first_value_event",
    "evidence_ladder",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.product-success-brief.v1"
    },
    "product_success_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_problem": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "job_to_be_done": {
      "type": "string",
      "minLength": 1
    },
    "context_of_use": {
      "type": "string",
      "minLength": 1
    },
    "desired_outcome": {
      "type": "string",
      "minLength": 1
    },
    "first_value_event": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ladder": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
