{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/product-success-brief.schema.json",
  "title": "product-success-brief",
  "oneOf": [
    { "$ref": "#/$defs/v1" },
    { "$ref": "#/$defs/v2" }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "claimIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "baseProperties": {
      "product_success_contract_id": { "$ref": "#/$defs/text" },
      "claim_ids": { "$ref": "#/$defs/claimIds" },
      "target_problem": { "$ref": "#/$defs/text" },
      "audience": { "$ref": "#/$defs/text" },
      "job_to_be_done": { "$ref": "#/$defs/text" },
      "context_of_use": { "$ref": "#/$defs/text" },
      "desired_outcome": { "$ref": "#/$defs/text" },
      "first_value_event": { "$ref": "#/$defs/text" },
      "evidence_ladder": { "$ref": "#/$defs/text" },
      "claim_ceiling": { "$ref": "#/$defs/text" }
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "product_success_contract_id", "claim_ids", "target_problem",
        "audience", "job_to_be_done", "context_of_use", "desired_outcome",
        "first_value_event", "evidence_ladder", "claim_ceiling"
      ],
      "properties": {
        "schema": { "const": "harness-ultragoal.product-success-brief.v1" },
        "product_success_contract_id": { "$ref": "#/$defs/text" },
        "claim_ids": { "$ref": "#/$defs/claimIds" },
        "target_problem": { "$ref": "#/$defs/text" },
        "audience": { "$ref": "#/$defs/text" },
        "job_to_be_done": { "$ref": "#/$defs/text" },
        "context_of_use": { "$ref": "#/$defs/text" },
        "desired_outcome": { "$ref": "#/$defs/text" },
        "first_value_event": { "$ref": "#/$defs/text" },
        "evidence_ladder": { "$ref": "#/$defs/text" },
        "claim_ceiling": { "$ref": "#/$defs/text" }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor_reference"],
      "properties": {
        "kind": { "enum": ["agent", "human", "agent_with_human_supervision"] },
        "actor_reference": { "$ref": "#/$defs/text" }
      }
    },
    "realWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_identity", "starting_candidate", "dirty_state_expectation",
        "task_id", "task", "expected_useful_outcome"
      ],
      "properties": {
        "repository_identity": { "$ref": "#/$defs/sha256" },
        "starting_candidate": { "$ref": "#/$defs/sha256" },
        "dirty_state_expectation": { "enum": ["clean", "dirty", "either"] },
        "task_id": { "$ref": "#/$defs/text" },
        "task": { "$ref": "#/$defs/text" },
        "expected_useful_outcome": { "$ref": "#/$defs/text" }
      }
    },
    "publicEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "route", "forbidden_bypasses"],
      "properties": {
        "surface_id": { "const": "PS-ENTRY" },
        "route": { "const": "harness-ultragoal" },
        "forbidden_bypasses": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "protectedInvariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim_ids", "surfaces", "required_condition", "disposition"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "claim_ids": { "$ref": "#/$defs/claimIds" },
        "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "required_condition": { "$ref": "#/$defs/text" },
        "disposition": { "const": "fail_closed" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id", "order", "dependency_ids", "capability_ids", "claim_ids",
        "product_surfaces", "expected_observation", "evidence_class"
      ],
      "properties": {
        "transition_id": { "$ref": "#/$defs/text" },
        "order": { "type": "integer", "minimum": 1 },
        "dependency_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "capability_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "claim_ids": { "$ref": "#/$defs/claimIds" },
        "product_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "expected_observation": { "$ref": "#/$defs/text" },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" }
      }
    },
    "failureControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "failure", "diagnosis", "recovery", "preservation"],
      "properties": {
        "transition_id": { "$ref": "#/$defs/text" },
        "failure": { "$ref": "#/$defs/text" },
        "diagnosis": { "$ref": "#/$defs/text" },
        "recovery": { "$ref": "#/$defs/text" },
        "preservation": { "$ref": "#/$defs/text" }
      }
    },
    "truthLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loop_id", "positive_path", "first_value_transition", "failure_control",
        "preservation_expectation", "repeat_use_expectation"
      ],
      "properties": {
        "loop_id": { "$ref": "#/$defs/text" },
        "positive_path": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } },
        "first_value_transition": { "$ref": "#/$defs/text" },
        "failure_control": { "$ref": "#/$defs/failureControl" },
        "preservation_expectation": { "$ref": "#/$defs/text" },
        "repeat_use_expectation": { "$ref": "#/$defs/text" }
      }
    },
    "depthTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_id", "kind", "risk_or_claim", "activation_finding_codes",
        "smallest_investment", "fitness_function", "invalidation_condition"
      ],
      "properties": {
        "trigger_id": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["protected_invariant", "observed_failure", "repeated_gap", "bounded_experiment"] },
        "risk_or_claim": { "$ref": "#/$defs/text" },
        "activation_finding_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "smallest_investment": { "$ref": "#/$defs/text" },
        "fitness_function": { "$ref": "#/$defs/text" },
        "invalidation_condition": { "$ref": "#/$defs/text" }
      }
    },
    "evidenceClass": {
      "enum": [
        "intent", "research", "prototype", "source", "package", "installed",
        "runtime", "agent_use", "human_use", "repeated_human_use"
      ]
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "product_success_contract_id", "product_success_contract_digest",
        "claim_ids", "target_problem", "audience", "job_to_be_done", "context_of_use",
        "desired_outcome", "first_value_event", "operator", "real_work",
        "public_entry_surface", "protected_invariants", "first_truth_loop",
        "depth_triggers", "evidence_class", "evidence_ladder", "claim_ceiling"
      ],
      "properties": {
        "schema": { "const": "harness-ultragoal.product-success-brief.v2" },
        "product_success_contract_id": { "$ref": "#/$defs/text" },
        "product_success_contract_digest": { "$ref": "#/$defs/sha256" },
        "claim_ids": { "$ref": "#/$defs/claimIds" },
        "target_problem": { "$ref": "#/$defs/text" },
        "audience": { "$ref": "#/$defs/text" },
        "job_to_be_done": { "$ref": "#/$defs/text" },
        "context_of_use": { "$ref": "#/$defs/text" },
        "desired_outcome": { "$ref": "#/$defs/text" },
        "first_value_event": { "$ref": "#/$defs/text" },
        "operator": { "$ref": "#/$defs/operator" },
        "real_work": { "$ref": "#/$defs/realWork" },
        "public_entry_surface": { "$ref": "#/$defs/publicEntry" },
        "protected_invariants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/protectedInvariant" } },
        "first_truth_loop": { "$ref": "#/$defs/truthLoop" },
        "depth_triggers": { "type": "array", "items": { "$ref": "#/$defs/depthTrigger" } },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "evidence_ladder": { "$ref": "#/$defs/text" },
        "claim_ceiling": { "$ref": "#/$defs/text" }
      }
    }
  }
}
