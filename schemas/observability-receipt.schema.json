{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/observability-receipt.schema.json",
  "title": "Harness Ultragoal Observability Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidate_digest",
    "run_id",
    "correlation_id",
    "trace_id",
    "surface",
    "operation",
    "log_stream_digest",
    "metric_snapshot_digest",
    "trace_bundle_digest",
    "query_examples",
    "redaction_proof",
    "retention_bounds_proof",
    "bounded_output_proof",
    "receipt_path",
    "claim_impact",
    "claim_ceiling",
    "blocked_claims",
    "supported_claims",
    "law_id",
    "check_id",
    "claim_id",
    "failure_class",
    "why_failed",
    "where_failed",
    "next_repair",
    "event",
    "metric",
    "trace"
  ],
  "properties": {
    "schema": { "const": "harness-ultragoal.observability-receipt.v1" },
    "status": { "enum": ["pass", "fail", "blocked"] },
    "candidate_digest": { "$ref": "schema-authority-primitives.schema.json#/$defs/sha256" },
    "run_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "surface": {
      "enum": [
        "source",
        "source_package",
        "archive",
        "installed",
        "cache",
        "app_registry",
        "coverage",
        "foundational_trace",
        "line_caps",
        "mandatory_law",
        "namespace",
        "product",
        "reviewer",
        "review_round",
        "review_target",
        "schema",
        "live_stack",
        "source_obligations",
        "standards_gardener",
        "target_repo",
        "codex_desktop_app_surface",
        "codex_desktop_plugin_registry",
        "installed_package_surface",
        "plugin_cache_surface",
        "source_local_update_goal_control_plane",
        "source_package_control_plane"
      ]
    },
    "operation": { "type": "string", "minLength": 1 },
    "log_stream_digest": { "$ref": "schema-authority-primitives.schema.json#/$defs/sha256" },
    "metric_snapshot_digest": { "$ref": "schema-authority-primitives.schema.json#/$defs/sha256" },
    "trace_bundle_digest": { "$ref": "schema-authority-primitives.schema.json#/$defs/sha256" },
    "query_examples": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "redaction_proof": { "enum": ["pass", "fail"] },
    "retention_bounds_proof": { "enum": ["pass", "fail"] },
    "bounded_output_proof": { "enum": ["pass", "fail"] },
    "receipt_path": { "type": "string" },
    "coverage_receipt_path": { "type": "string" },
    "claim_impact": { "type": "string", "minLength": 1 },
    "claim_ceiling": { "type": "string" },
    "blocked_claims": { "type": "array", "items": { "type": "string" } },
    "supported_claims": { "type": "array", "items": { "type": "string" } },
    "law_id": { "type": "string", "minLength": 1 },
    "check_id": { "type": "string", "minLength": 1 },
    "claim_id": { "type": "string", "minLength": 1 },
    "failure_class": { "type": "string" },
    "why_failed": { "type": "string" },
    "where_failed": { "type": "string" },
    "next_repair": { "type": "string", "minLength": 1 },
    "event": { "$ref": "observability-event.schema.json" },
    "metric": { "$ref": "observability-metric.schema.json" },
    "trace": { "$ref": "observability-trace.schema.json" }
  }
}
