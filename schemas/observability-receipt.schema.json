{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/observability-receipt.schema.json",
  "title": "Harness Ultragoal Observability Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidate_digest",
    "run_id",
    "correlation_id",
    "surface",
    "operation",
    "log_stream_digest",
    "metric_snapshot_digest",
    "trace_bundle_digest",
    "query_examples",
    "redaction_proof",
    "retention_bounds_proof",
    "bounded_output_proof",
    "receipt_path",
    "claim_ceiling",
    "blocked_claims",
    "supported_claims",
    "law_id",
    "check_id",
    "claim_id",
    "why_failed",
    "where_failed",
    "next_repair",
    "event",
    "metric",
    "trace"
  ],
  "properties": {
    "schema": { "const": "harness-ultragoal.observability-receipt.v1" },
    "status": { "enum": ["pass", "fail", "blocked"] },
    "candidate_digest": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "run_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "surface": { "enum": ["source", "installed", "cache", "app_registry", "reviewer", "live_stack", "target_repo"] },
    "operation": { "type": "string", "minLength": 1 },
    "log_stream_digest": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "metric_snapshot_digest": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "trace_bundle_digest": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "query_examples": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "redaction_proof": { "enum": ["pass", "fail"] },
    "retention_bounds_proof": { "enum": ["pass", "fail"] },
    "bounded_output_proof": { "enum": ["pass", "fail"] },
    "receipt_path": { "type": "string" },
    "claim_ceiling": { "type": "string" },
    "blocked_claims": { "type": "array", "items": { "type": "string" } },
    "supported_claims": { "type": "array", "items": { "type": "string" } },
    "law_id": { "const": "full-local-observability-stack-integration-non-opaque-failure" },
    "check_id": { "const": "full-local-observability-stack-integration-non-opaque-failure" },
    "claim_id": { "const": "gate-92-observability-control-plane" },
    "why_failed": { "type": "string" },
    "where_failed": { "type": "string" },
    "next_repair": { "type": "string", "minLength": 1 },
    "event": { "$ref": "observability-event.schema.json" },
    "metric": { "$ref": "observability-metric.schema.json" },
    "trace": { "$ref": "observability-trace.schema.json" }
  }
}
