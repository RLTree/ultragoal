{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/foundational-law-traceability.schema.json",
  "title": "Harness Ultragoal Foundational Law Traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.foundational-law-traceability.v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "source_artifact",
          "law_id",
          "standards_row_id",
          "validator_check_id",
          "red_fixture_id",
          "valid_fixture_id",
          "receipt_requirement",
          "claim_ceiling_impact"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "source_artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "law_id": {
            "type": "string",
            "minLength": 1
          },
          "standards_row_id": {
            "type": "string",
            "minLength": 1
          },
          "validator_check_id": {
            "$ref": "common-defs.schema.json#/$defs/requiredValidatorCheckId"
          },
          "red_fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "valid_fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "receipt_requirement": {
            "type": "string",
            "minLength": 1
          },
          "claim_ceiling_impact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
