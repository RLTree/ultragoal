{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/product-review-disposition.schema.json",
  "title": "product-review-disposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reviewer_id",
    "persona",
    "product_success_contract_id",
    "decision",
    "affected_claim_ids",
    "evidence_paths",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.product-review-disposition.v1"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "persona": {
      "type": "string",
      "minLength": 1
    },
    "product_success_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "sign_off",
        "revise_before_next_phase",
        "blocked",
        "judgment_only_claim_blocker"
      ]
    },
    "affected_claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
