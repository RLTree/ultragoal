{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/observability-metric.schema.json",
  "title": "Harness Ultragoal Observability Metric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "correlation_id",
    "trace_id",
    "span_id",
    "parent_span_id",
    "command",
    "subcommand",
    "operation",
    "surface",
    "law_id",
    "check_id",
    "claim_id",
    "candidate_digest",
    "target_revision",
    "artifact_path",
    "receipt_path",
    "status",
    "failure_class",
    "why_failed",
    "where_failed",
    "next_repair",
    "claim_impact",
    "timestamp",
    "duration_ms",
    "exporter",
    "redaction_status",
    "bounded_output_status",
    "query_hint_logql",
    "query_hint_promql",
    "query_hint_traceql",
    "metric_name",
    "metric_value",
    "labels"
  ],
  "properties": {
    "schema": { "const": "harness-ultragoal.observability-metric.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "span_id": { "type": "string", "minLength": 1 },
    "parent_span_id": { "type": "string" },
    "command": { "type": "string", "minLength": 1 },
    "subcommand": { "type": "string" },
    "operation": { "type": "string", "minLength": 1 },
    "surface": { "enum": ["source", "installed", "cache", "app_registry", "reviewer", "live_stack", "target_repo"] },
    "law_id": { "type": "string" },
    "check_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "candidate_digest": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "target_revision": { "type": "string" },
    "artifact_path": { "type": "string" },
    "receipt_path": { "type": "string" },
    "status": { "enum": ["pass", "fail", "blocked"] },
    "failure_class": { "type": "string" },
    "why_failed": { "type": "string" },
    "where_failed": { "type": "string" },
    "next_repair": { "type": "string" },
    "claim_impact": { "type": "string" },
    "timestamp": { "$ref": "common-defs.schema.json#/$defs/isoTimestamp" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "exporter": { "enum": ["victoriametrics", "local_spool", "stdout", "receipt"] },
    "redaction_status": { "enum": ["pass", "fail"] },
    "bounded_output_status": { "enum": ["pass", "fail", "truncated"] },
    "query_hint_logql": { "type": "string" },
    "query_hint_promql": { "type": "string" },
    "query_hint_traceql": { "type": "string" },
    "metric_name": {
      "enum": [
        "ultragoal_command_total",
        "ultragoal_command_duration_ms",
        "ultragoal_check_total",
        "ultragoal_check_failure_total",
        "ultragoal_law_failure_total",
        "ultragoal_receipt_deref_total",
        "ultragoal_receipt_stale_total",
        "ultragoal_receipt_digest_mismatch_total",
        "ultragoal_claim_block_total",
        "ultragoal_red_fixture_total",
        "ultragoal_red_fixture_failure_total",
        "ultragoal_proof_graph_cycle_total",
        "ultragoal_registry_unsupported_total",
        "ultragoal_observability_emit_failure_total",
        "ultragoal_exporter_retry_total",
        "ultragoal_exporter_drop_total",
        "ultragoal_stack_health_status",
        "ultragoal_stack_smoke_status"
      ]
    },
    "metric_value": { "type": "number" },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "operation", "status", "law_id", "check_id", "claim_id", "surface", "failure_class", "candidate_digest", "exporter"],
      "properties": {
        "command": { "type": "string" },
        "operation": { "type": "string" },
        "status": { "type": "string" },
        "law_id": { "type": "string" },
        "check_id": { "type": "string" },
        "claim_id": { "type": "string" },
        "surface": { "type": "string" },
        "failure_class": { "type": "string" },
        "candidate_digest": { "type": "string" },
        "exporter": { "type": "string" }
      }
    }
  }
}
