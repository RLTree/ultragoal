{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/observability-trace.schema.json",
  "title": "Harness Ultragoal Observability Trace Span",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "correlation_id",
    "trace_id",
    "span_id",
    "parent_span_id",
    "command",
    "subcommand",
    "operation",
    "surface",
    "law_id",
    "check_id",
    "claim_id",
    "candidate_digest",
    "target_revision",
    "artifact_path",
    "receipt_path",
    "status",
    "failure_class",
    "why_failed",
    "where_failed",
    "next_repair",
    "claim_impact",
    "timestamp",
    "duration_ms",
    "worker_count",
    "task_count",
    "queue_depth",
    "cpu_ms",
    "memory_bytes",
    "io_bytes",
    "cache_mode",
    "resource_measurement_status",
    "retry_count",
    "backoff_ms",
    "saturation_status",
    "repair_anchor_before",
    "repair_anchor_after",
    "exporter",
    "redaction_status",
    "bounded_output_status",
    "query_hint_logql",
    "query_hint_promql",
    "query_hint_traceql",
    "span_kind",
    "span_name",
    "child_spans"
  ],
  "properties": {
    "schema": { "const": "harness-ultragoal.observability-trace.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "span_id": { "type": "string", "minLength": 1 },
    "parent_span_id": { "type": "string" },
    "command": { "type": "string", "minLength": 1 },
    "subcommand": { "type": "string" },
    "operation": { "type": "string", "minLength": 1 },
    "surface": {
      "enum": [
        "source",
        "source_package",
        "archive",
        "installed",
        "cache",
        "app_registry",
        "coverage",
        "foundational_trace",
        "line_caps",
        "mandatory_law",
        "namespace",
        "product",
        "reviewer",
        "review_round",
        "review_target",
        "schema",
        "live_stack",
        "source_obligations",
        "standards_gardener",
        "target_repo",
        "codex_desktop_app_surface",
        "codex_desktop_plugin_registry",
        "installed_package_surface",
        "plugin_cache_surface",
        "source_local_update_goal_control_plane",
        "source_package_control_plane"
      ]
    },
    "law_id": { "type": "string" },
    "check_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "candidate_digest": { "$ref": "schema-authority-primitives.schema.json#/$defs/sha256" },
    "target_revision": { "type": "string" },
    "artifact_path": { "type": "string" },
    "receipt_path": { "type": "string" },
    "status": { "enum": ["pass", "fail", "blocked"] },
    "failure_class": { "type": "string" },
    "why_failed": { "type": "string" },
    "where_failed": { "type": "string" },
    "next_repair": { "type": "string" },
    "claim_impact": { "type": "string" },
    "timestamp": { "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "worker_count": { "type": "integer", "minimum": 0 },
    "task_count": { "type": "integer", "minimum": 0 },
    "queue_depth": { "type": "integer", "minimum": 0 },
    "cpu_ms": { "type": ["integer", "null"], "minimum": 0 },
    "memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "io_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "cache_mode": { "type": "string", "minLength": 1 },
    "resource_measurement_status": { "type": "string", "minLength": 1 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "backoff_ms": { "type": "integer", "minimum": 0 },
    "saturation_status": { "type": "string", "minLength": 1 },
    "repair_anchor_before": { "type": "string", "minLength": 1 },
    "repair_anchor_after": { "type": "string", "minLength": 1 },
    "exporter": { "enum": ["victoriatraces", "local_spool", "stdout", "receipt"] },
    "redaction_status": { "enum": ["pass", "fail"] },
    "bounded_output_status": { "enum": ["pass", "fail", "truncated"] },
    "query_hint_logql": { "type": "string" },
    "query_hint_promql": { "type": "string" },
    "query_hint_traceql": { "type": "string" },
    "span_kind": { "enum": ["root", "validator_check", "schema_parse", "receipt_deref", "fixture_run", "claim_ceiling", "final_packet_deref", "surface_probe", "exporter_call"] },
    "span_name": { "type": "string", "minLength": 1 },
    "child_spans": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/child_span" }
    }
  },
  "$defs": {
    "child_span": {
      "type": "object",
      "required": [
        "run_id",
        "correlation_id",
        "trace_id",
        "span_id",
        "parent_span_id",
        "operation",
        "status",
        "law_id",
        "check_id",
        "claim_id",
        "candidate_digest",
        "span_kind",
        "span_name"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "correlation_id": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "span_id": { "type": "string", "minLength": 1 },
        "parent_span_id": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "blocked"] },
        "law_id": { "type": "string" },
        "check_id": { "type": "string" },
        "claim_id": { "type": "string" },
        "candidate_digest": { "$ref": "schema-authority-primitives.schema.json#/$defs/sha256" },
        "span_kind": { "enum": ["validator_check", "schema_parse", "receipt_deref", "fixture_run", "claim_ceiling", "final_packet_deref", "surface_probe", "exporter_call"] },
        "span_name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
