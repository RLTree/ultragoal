{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/completion-manifest.schema.json",
  "title": "Harness Ultragoal completion projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_bundle_hash", "required_claim_ids", "required_claim_ids_hash", "goal_binding", "lineage", "candidate_resolution", "candidate_status", "root", "claim_ceiling", "claims", "verification_backlog_path", "registry_preimage_digest", "verification_backlog_digest", "validator_receipts", "generated_at"],
  "properties": {
    "schema": {"const": "harness-ultragoal.completion-manifest.v1"},
    "contract_bundle_hash": {"$ref": "#/$defs/sha256"},
    "required_claim_ids": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"$ref": "#/$defs/claim_id"}},
    "required_claim_ids_hash": {"$ref": "#/$defs/sha256"},
    "goal_binding": {"$ref": "#/$defs/goal_binding"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "candidate_resolution": {"$ref": "#/$defs/candidate_resolution"},
    "candidate_status": {"const": "pending"},
    "root": {"type": "string", "minLength": 1},
    "claim_ceiling": {"$ref": "#/$defs/claim_ceiling"},
    "claims": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/claim"}},
    "verification_backlog_path": {"const": "VERIFICATION_BACKLOG.json"},
    "registry_preimage_digest": {"$ref": "#/$defs/sha256"},
    "verification_backlog_digest": {"$ref": "#/$defs/sha256"},
    "validator_receipts": {"const": []},
    "generated_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hex40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "claim_id": {"type": "string", "pattern": "^CL-[A-Z0-9-]+$"},
    "goal_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "goal_id", "objective", "contract_path", "checked_at", "gap_reason", "discovery_probe_receipt"],
      "properties": {
        "status": {"const": "blocked"}, "goal_id": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "contract_path": {"const": "GOAL_CONTRACT.md"}, "checked_at": {"$ref": "#/$defs/timestamp"}, "gap_reason": {"type": "string", "minLength": 1},
        "discovery_probe_receipt": {"$ref": "#/$defs/probe_receipt"}
      }
    },
    "probe_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_surface", "attempted_tools", "verdict", "actor_id", "workspace", "output", "checked_at"],
      "properties": {
        "tool_surface": {"type": "string", "minLength": 1}, "attempted_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "get_goal"}}, "verdict": {"const": "blocked"}, "actor_id": {"type": "string", "minLength": 1}, "workspace": {"type": "string", "minLength": 1}, "output": {"$ref": "#/$defs/artifact_ref"}, "checked_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "artifact_ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/sha256"}}
    },
    "lineage": {
      "type": "object", "additionalProperties": false, "required": ["goal", "amendments", "contract_bundle"],
      "properties": {
        "goal": {"$ref": "#/$defs/current_ref"}, "amendments": {"$ref": "#/$defs/current_ref"}, "contract_bundle": {"$ref": "#/$defs/current_ref"}
      }
    },
    "current_ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest", "validity", "invalidation"],
      "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/sha256"}, "validity": {"const": "current_exact"}, "invalidation": {"const": "invalidate_on_any_byte_change"}}
    },
    "candidate_resolution": {"type": "object", "additionalProperties": false, "required": ["kind", "identity_command", "requires_clean_tree", "protected_base_ref"], "properties": {"kind": {"const": "containing_clean_head"}, "identity_command": {"const": "git rev-parse HEAD^{commit} HEAD^{tree}"}, "requires_clean_tree": {"const": true}, "protected_base_ref": {"const": "LANE_REGISTRY.json#/root_freeze/protected_base"}}},
    "claim_ceiling": {
      "type": "object", "additionalProperties": false, "required": ["effect", "all_claims_withheld", "reason"],
      "properties": {"effect": {"const": "withheld"}, "all_claims_withheld": {"const": true}, "reason": {"type": "string", "minLength": 1}}
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "description", "claim_scope", "claim_kind", "status", "claim_surface", "allowed_evidence_surfaces", "evidence", "claim_ceiling_effect", "backlog_row_id"],
      "properties": {
        "id": {"$ref": "#/$defs/claim_id"}, "title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "claim_scope": {"const": "required"}, "claim_kind": {"type": "string", "minLength": 1}, "status": {"const": "withheld_claim"}, "claim_surface": {"type": "string", "minLength": 1}, "allowed_evidence_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence": {"const": []}, "claim_ceiling_effect": {"const": "withheld"}, "backlog_row_id": {"type": "string", "pattern": "^BACKLOG-[0-9]{3,}$"}
      }
    }
  }
}
