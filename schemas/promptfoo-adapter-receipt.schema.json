{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/promptfoo-adapter-receipt.schema.json",
  "title": "Harness Ultragoal promptfoo Adapter Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidate_digest",
    "package_json_digest",
    "pnpm_lock_digest",
    "pnpm_workspace_digest",
    "promptfoo_version",
    "provider_registry_path",
    "provider_registry_digest",
    "suite_registry_path",
    "suite_registry_digest",
    "provider_modes",
    "suite_ids",
    "raw_promptfoo_authority",
    "observability_receipt",
    "supported_claims",
    "blocked_claims",
    "claim_impact",
    "failures"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.promptfoo-adapter-receipt.v1"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "package_json_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pnpm_lock_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pnpm_workspace_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "promptfoo_version": {
      "const": "0.121.17"
    },
    "provider_registry_path": {
      "const": "docs/promptfoo-provider-registry.json"
    },
    "provider_registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "suite_registry_path": {
      "const": "docs/promptfoo-suite-registry.json"
    },
    "suite_registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provider_modes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "suite_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "raw_promptfoo_authority": {
      "const": "observation_only_until_cli_parsed_receipt"
    },
    "observability_receipt": {
      "type": "object"
    },
    "supported_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_claims": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "string"
      }
    },
    "claim_impact": {
      "type": "string",
      "minLength": 1
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
