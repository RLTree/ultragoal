{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/documentation-freshness-receipt.schema.json",
  "title": "Harness Ultragoal Documentation Freshness Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "changed_surfaces",
    "affected_docs",
    "stale_docs",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.documentation-freshness-receipt.v1"
    },
    "changed_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affected_docs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stale_docs": {
      "type": "array",
      "maxItems": 0
    },
    "claim_ceiling": {
      "enum": [
        "docs_current_for_changed_surfaces",
        "withheld_due_to_stale_docs"
      ]
    }
  }
}
