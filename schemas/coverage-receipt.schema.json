{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/coverage-receipt.schema.json",
  "title": "Harness Ultragoal Coverage Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "command",
    "tool",
    "source_tree_digest",
    "coverage_manifest_digest",
    "coverage_command_digest",
    "changed_files_digest",
    "tool_version",
    "workspace_root",
    "target_revision",
    "command_started_at",
    "command_completed_at",
    "command_exit",
    "machine_readable_report",
    "generated_by",
    "percent_source",
    "target_paths",
    "measured_dimensions",
    "coverage",
    "uncovered_records",
    "exclusions",
    "generated_at",
    "claim_ceiling",
    "supported_claim_classes",
    "blocked_claim_classes"
  ],
  "properties": {
    "schema": { "const": "harness-ultragoal.coverage-receipt.v1" },
    "claim_id": { "$ref": "common-defs.schema.json#/$defs/claimId" },
    "command": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "source_tree_digest": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "coverage_manifest_digest": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "coverage_command_digest": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "changed_files_digest": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "tool_version": { "type": "string", "minLength": 1 },
    "workspace_root": { "type": "string", "minLength": 1 },
    "target_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["git_commit", "package_digest"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "command_started_at": { "$ref": "common-defs.schema.json#/$defs/isoTimestamp" },
    "command_completed_at": { "$ref": "common-defs.schema.json#/$defs/isoTimestamp" },
    "command_exit": { "const": 0 },
    "machine_readable_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "common-defs.schema.json#/$defs/sha256" }
      }
    },
    "generated_by": { "const": "coverage-command" },
    "percent_source": { "const": "machine_readable_report" },
    "target_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "measured_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["line", "branch", "function", "region", "ui_state", "artifact"]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percent", "floor_percent", "policy"],
      "properties": {
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "floor_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "policy": {
          "enum": ["100_percent_required", "ratchet_floor", "blocked_or_withheld"]
        },
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "blocker_or_debt_id": { "type": "string", "minLength": 1 }
      }
    },
    "uncovered_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "owner", "blocker_or_debt_id"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "blocker_or_debt_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "rationale", "reviewed", "counts_as_covered"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["generated", "vendor", "external"] },
          "rationale": { "type": "string", "minLength": 1 },
          "reviewed": { "const": true },
          "counts_as_covered": { "const": false }
        }
      }
    },
    "generated_at": { "$ref": "common-defs.schema.json#/$defs/isoTimestamp" },
    "claim_ceiling": {
      "enum": [
        "supports_complete_coverage_claim",
        "ratchet_floor_only",
        "withheld_or_blocked"
      ]
    },
    "supported_claim_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["complete_coverage"]
      }
    },
    "blocked_claim_classes": {
      "type": "array",
      "uniqueItems": true,
      "contains": { "const": "completion" },
      "items": {
        "enum": [
          "completion",
          "package_readiness",
          "review_readiness",
          "release_readiness",
          "final_packet_correctness",
          "update_goal_eligibility",
          "app_registry_or_reviewer_exposure"
        ]
      }
    }
  }
}
