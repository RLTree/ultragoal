{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/product-success-contract.schema.json",
  "title": "product-success-contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product_success_contract_id",
    "contract_version",
    "goal_id",
    "target_revision",
    "claim_ids",
    "product_surface_classification",
    "target_user_or_operator",
    "job_to_be_done",
    "context_of_use",
    "desired_user_outcome",
    "business_or_mission_outcome",
    "critical_journey_id",
    "critical_journey_steps",
    "first_value_event",
    "quality_in_use_dimensions",
    "accessibility_gate",
    "cognitive_load_gate",
    "recovery_burden_gate",
    "trust_burden_gate",
    "human_attention_policy",
    "continuance_required",
    "evidence_ladder_required_level",
    "forbidden_substitutions",
    "non_goal_product_claims",
    "claim_ceiling",
    "producer_actor_id",
    "review_owner",
    "generated_at",
    "receipt_digest"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.product-success-contract.v1"
    },
    "product_success_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "target_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "product_surface_classification": {
      "type": "string",
      "minLength": 1
    },
    "target_user_or_operator": {
      "type": "string",
      "minLength": 1
    },
    "job_to_be_done": {
      "type": "string",
      "minLength": 1
    },
    "context_of_use": {
      "type": "string",
      "minLength": 1
    },
    "desired_user_outcome": {
      "type": "string",
      "minLength": 1
    },
    "business_or_mission_outcome": {
      "type": "string",
      "minLength": 1
    },
    "critical_journey_id": {
      "type": "string",
      "minLength": 1
    },
    "critical_journey_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "first_value_event": {
      "type": "string",
      "minLength": 1
    },
    "quality_in_use_dimensions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "enum": [
          "effectiveness",
          "efficiency",
          "satisfaction",
          "freedom_from_risk",
          "context_coverage"
        ]
      }
    },
    "accessibility_gate": {
      "type": "string",
      "minLength": 1
    },
    "cognitive_load_gate": {
      "type": "string",
      "minLength": 1
    },
    "recovery_burden_gate": {
      "type": "string",
      "minLength": 1
    },
    "trust_burden_gate": {
      "type": "string",
      "minLength": 1
    },
    "human_attention_policy": {
      "type": "string",
      "minLength": 1
    },
    "continuance_required": {
      "type": "boolean"
    },
    "evidence_ladder_required_level": {
      "enum": [
        "Known",
        "Inferred",
        "Assumed",
        "Missing"
      ]
    },
    "forbidden_substitutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goal_product_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "producer_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "review_owner": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
