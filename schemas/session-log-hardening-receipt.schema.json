{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/session-log-hardening-receipt.schema.json",
  "title": "Harness Ultragoal Session Log Hardening Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generated_at",
    "candidate_version",
    "source_root",
    "package_digest",
    "audit_sources",
    "required_issue_classes",
    "findings",
    "packet_successor",
    "active_registry_current_proof",
    "current_claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.session-log-hardening-receipt.v1"
    },
    "status": {
      "const": "pass"
    },
    "generated_at": {
      "$ref": "common-defs.schema.json#/$defs/isoTimestamp"
    },
    "candidate_version": {
      "type": "string",
      "minLength": 1
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "package_digest": {
      "$ref": "common-defs.schema.json#/$defs/sha256"
    },
    "audit_sources": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/auditSource"
      }
    },
    "required_issue_classes": {
      "type": "array",
      "minItems": 15,
      "items": {
        "$ref": "#/$defs/issueClass"
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "packet_successor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "purpose"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "const": "implemented_findings_and_remaining_blockers"
        }
      }
    },
    "active_registry_current_proof": {
      "enum": [
        "not_produced",
        "produced"
      ]
    },
    "current_claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "auditSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "artifact",
        "source_kind",
        "timestamp_utc",
        "summary"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "chronicle_summary",
            "session_log",
            "packet_summary",
            "validator_receipt"
          ]
        },
        "timestamp_utc": {
          "$ref": "common-defs.schema.json#/$defs/isoTimestamp"
        },
        "session_id": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issueClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "disposition",
        "finding_ids"
      ],
      "properties": {
        "class_id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "finding_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "source_refs",
        "timestamp_or_session_id",
        "observed_gap",
        "affected_surface",
        "enforcement_status",
        "required_repair",
        "claim_ceiling_impact",
        "artifact_types"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timestamp_or_session_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_gap": {
          "type": "string",
          "minLength": 1
        },
        "affected_surface": {
          "type": "string",
          "minLength": 1
        },
        "enforcement_status": {
          "$ref": "#/$defs/disposition"
        },
        "required_repair": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling_impact": {
          "type": "string",
          "minLength": 1
        },
        "artifact_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "code",
              "schema",
              "fixture",
              "receipt",
              "doc",
              "validator",
              "install-cache-refresh",
              "packet",
              "blocker"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "disposition": {
      "enum": [
        "fixed",
        "already_enforced",
        "intentionally_blocked",
        "non_goal"
      ]
    }
  }
}
