{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/restartable-execplan-receipt.schema.json",
  "title": "Harness Ultragoal Restartable ExecPlan Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "active_execplan_paths",
    "required_sections",
    "stale",
    "prose_only",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.restartable-execplan-receipt.v1"
    },
    "active_execplan_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "user_outcome",
        "steps",
        "progress",
        "discoveries",
        "decisions",
        "validation_commands",
        "idempotence",
        "recovery",
        "working_behavior"
      ],
      "properties": {
        "purpose": {
          "const": true
        },
        "user_outcome": {
          "const": true
        },
        "steps": {
          "const": true
        },
        "progress": {
          "const": true
        },
        "discoveries": {
          "const": true
        },
        "decisions": {
          "const": true
        },
        "validation_commands": {
          "const": true
        },
        "idempotence": {
          "const": true
        },
        "recovery": {
          "const": true
        },
        "working_behavior": {
          "const": true
        }
      }
    },
    "stale": {
      "const": false
    },
    "prose_only": {
      "const": false
    },
    "claim_ceiling": {
      "enum": [
        "restartable_execplans_enforced",
        "withheld_until_restartable_execplan_receipt"
      ]
    }
  }
}
