{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/cli-transactional-finalization-receipt.schema.json",
  "title": "Harness Ultragoal CLI Transactional Finalization Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "candidate_digest",
    "status",
    "claim_ceiling",
    "transaction_mode",
    "blocked_claim_classes",
    "final_packet",
    "registry_exposure",
    "cli_performance",
    "coverage",
    "failure"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.cli-transactional-finalization-receipt.v1"
    },
    "generated_at": {
      "$ref": "common-defs.schema.json#/$defs/isoTimestamp"
    },
    "candidate_digest": {
      "$ref": "common-defs.schema.json#/$defs/sha256"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "claim_ceiling": {
      "enum": [
        "supports_update_goal_eligibility",
        "withheld_or_blocked"
      ]
    },
    "transaction_mode": {
      "const": "same_candidate_atomic_finalization"
    },
    "blocked_claim_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "final_packet": {
      "$ref": "#/$defs/finalPacketReference"
    },
    "registry_exposure": {
      "$ref": "#/$defs/registryExposureReference"
    },
    "cli_performance": {
      "$ref": "#/$defs/cliPerformanceReference"
    },
    "coverage": {
      "$ref": "#/$defs/coverageReference"
    },
    "failure": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "observed_failures"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "observed_failures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "law_id": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "why_failed": {
      "type": "string"
    },
    "where_failed": {
      "type": "string"
    },
    "next_repair": {
      "type": "string",
      "minLength": 1
    },
    "claim_impact": {
      "type": "string",
      "minLength": 1
    },
    "receipt_observability_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_receipt_path",
        "run_id",
        "correlation_id",
        "log_stream_digest",
        "metric_snapshot_digest",
        "trace_bundle_digest"
      ],
      "properties": {
        "command_receipt_path": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "log_stream_digest": {
          "$ref": "common-defs.schema.json#/$defs/sha256"
        },
        "metric_snapshot_digest": {
          "$ref": "common-defs.schema.json#/$defs/sha256"
        },
        "trace_bundle_digest": {
          "$ref": "common-defs.schema.json#/$defs/sha256"
        }
      }
    },
    "observability": {
      "$ref": "observability-receipt.schema.json"
    }
  },
  "$defs": {
    "referenceBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "common-defs.schema.json#/$defs/sha256"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "finalPacketReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "path": { "const": "validation_artifacts/review/final-packet-proof.json" } } }
      ]
    },
    "registryExposureReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "path": { "const": "validation_artifacts/ultragoal-audit/active-registry-exposure-current.json" } } }
      ]
    },
    "cliPerformanceReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "path": { "const": "validation_artifacts/cli/performance-receipt.json" } } }
      ]
    },
    "coverageReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "path": { "const": "validation_artifacts/coverage/coverage-receipt.json" } } }
      ]
    }
  }
}
