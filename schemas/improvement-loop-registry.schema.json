{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/improvement-loop-registry.schema.json",
  "title": "Harness Ultragoal Improvement Loop Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "law_id", "forbidden_substitutions", "loops", "learning_adoption"],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.improvement-loop-registry.v1"
    },
    "law_id": {
      "const": "harness-improvement-loop-trace-feedback-eval-codex-handoff"
    },
    "forbidden_substitutions": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "loops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "loop_id",
          "loop_closure_status",
          "trace_ids",
          "feedback_ids",
          "cluster_ids",
          "eval_ids",
          "promptfoo_suite_ids",
          "halo_ranking_ids",
          "codex_handoff_ids",
          "implementation_change_ids",
          "validation_receipt_ids",
          "before_after_telemetry_ids",
          "promotion_ids",
          "stage_evidence_path",
          "stage_evidence_schema",
          "stage_evidence_digest",
          "stage_statuses"
        ],
        "properties": {
          "loop_id": {
            "type": "string",
            "minLength": 1
          },
          "loop_closure_status": {
            "enum": ["complete_same_candidate", "incomplete_fail_closed"]
          },
          "trace_ids": { "$ref": "#/$defs/non_empty_strings" },
          "feedback_ids": { "$ref": "#/$defs/non_empty_strings" },
          "cluster_ids": { "$ref": "#/$defs/non_empty_strings" },
          "eval_ids": { "$ref": "#/$defs/non_empty_strings" },
          "promptfoo_suite_ids": { "$ref": "#/$defs/non_empty_strings" },
          "halo_ranking_ids": { "$ref": "#/$defs/non_empty_strings" },
          "codex_handoff_ids": { "$ref": "#/$defs/non_empty_strings" },
          "implementation_change_ids": { "$ref": "#/$defs/non_empty_strings" },
          "validation_receipt_ids": { "$ref": "#/$defs/non_empty_strings" },
          "before_after_telemetry_ids": { "$ref": "#/$defs/non_empty_strings" },
          "promotion_ids": { "$ref": "#/$defs/non_empty_strings" },
          "stage_evidence_path": {
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "^/|(^|/)\\.\\.(/|$)" }
          },
          "stage_evidence_schema": {
            "const": "harness-ultragoal.improvement-loop-stage-evidence.v1"
          },
          "stage_evidence_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "stage_statuses": {
            "type": "array",
            "minItems": 11,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage_id", "status"],
              "properties": {
                "stage_id": {
                  "enum": [
                    "trace_capture",
                    "typed_feedback",
                    "feedback_clustering",
                    "eval_generation",
                    "promptfoo_execution",
                    "halo_ranking",
                    "codex_handoff",
                    "implementation_linkage",
                    "narrow_validation",
                    "before_after_telemetry",
                    "promotion_to_law"
                  ]
                },
                "status": {
                  "enum": ["complete", "partial", "missing"]
                }
              }
            }
          }
        }
      }
    },
    "learning_adoption": {
      "$ref": "#/$defs/learning_adoption"
    }
  },
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "learning_adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "one_learning_at_a_time", "records", "knowledge_projection"],
      "properties": {
        "schema": {
          "const": "harness-ultragoal.learning-adoption.v1"
        },
        "one_learning_at_a_time": {
          "const": true
        },
        "records": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/learning_record"
          }
        },
        "knowledge_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "schema", "format", "generator"],
          "properties": {
            "path": {
              "const": "docs/improvement-loop/knowledge-projection.md"
            },
            "schema": {
              "const": "harness-ultragoal.improvement-loop-knowledge-projection.v1"
            },
            "format": {
              "const": "markdown"
            },
            "generator": {
              "const": "validator/src/audit/improvement_loop/mod.rs"
            }
          }
        }
      }
    },
    "learning_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id", "version", "owner", "status", "observation", "provenance",
        "operating_envelope", "evidence_class", "facts", "interpretations", "hypotheses",
        "counterevidence", "responsible_layer", "mechanism_hypothesis", "recurrence",
        "severity", "intervention_burden", "proposed_intervention", "rejected_alternatives",
        "evaluation", "results", "decision", "review_date", "expiry_or_invalidation",
        "rollback", "residual_risks", "authority_handoff", "repair_budget"
      ],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["proposed", "adopted", "held", "narrowed", "rejected", "superseded", "retired"]
        },
        "observation": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/non_empty_strings" },
        "operating_envelope": { "type": "string", "minLength": 1 },
        "evidence_class": {
          "enum": ["isolated", "recurring", "cross_context", "causal", "unresolved"]
        },
        "facts": { "$ref": "#/$defs/non_empty_strings" },
        "interpretations": { "$ref": "#/$defs/non_empty_strings" },
        "hypotheses": { "$ref": "#/$defs/non_empty_strings" },
        "counterevidence": { "$ref": "#/$defs/non_empty_strings" },
        "responsible_layer": {
          "enum": ["specification", "context", "tool", "harness", "loop", "graph", "runtime", "repository", "software", "product", "lifecycle", "human_boundary"]
        },
        "mechanism_hypothesis": { "type": "string", "minLength": 1 },
        "recurrence": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "intervention_burden": { "type": "string", "minLength": 1 },
        "proposed_intervention": { "type": "string", "minLength": 1 },
        "rejected_alternatives": { "$ref": "#/$defs/non_empty_strings" },
        "evaluation": { "$ref": "#/$defs/learning_evaluation" },
        "results": { "$ref": "#/$defs/non_empty_strings" },
        "decision": {
          "enum": ["adopt", "hold", "narrow", "reject", "supersede", "retire"]
        },
        "review_date": { "type": "string", "minLength": 1 },
        "expiry_or_invalidation": { "$ref": "#/$defs/non_empty_strings" },
        "rollback": { "type": "string", "minLength": 1 },
        "residual_risks": { "$ref": "#/$defs/non_empty_strings" },
        "authority_handoff": { "type": "string", "minLength": 1 },
        "repair_budget": { "$ref": "#/$defs/repair_budget" },
        "supersedes": { "type": "string", "minLength": 1 },
        "superseded_by": { "type": "string", "minLength": 1 }
      }
    },
    "learning_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline", "visible", "held_out", "negative_controls", "overlap", "already_specified",
        "no_change", "semantic_mutation", "specification_evolution", "measures"
      ],
      "properties": {
        "baseline": { "$ref": "#/$defs/non_empty_strings" },
        "visible": { "$ref": "#/$defs/non_empty_strings" },
        "held_out": { "$ref": "#/$defs/non_empty_strings" },
        "negative_controls": { "$ref": "#/$defs/non_empty_strings" },
        "overlap": { "$ref": "#/$defs/non_empty_strings" },
        "already_specified": { "$ref": "#/$defs/non_empty_strings" },
        "no_change": { "$ref": "#/$defs/non_empty_strings" },
        "semantic_mutation": { "$ref": "#/$defs/non_empty_strings" },
        "specification_evolution": { "$ref": "#/$defs/non_empty_strings" },
        "measures": { "$ref": "#/$defs/non_empty_strings" }
      }
    },
    "repair_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_family", "operating_envelope", "max_repair_attempts", "calibration_basis", "universal_count"],
      "properties": {
        "task_family": { "type": "string", "minLength": 1 },
        "operating_envelope": { "type": "string", "minLength": 1 },
        "max_repair_attempts": { "type": "integer", "minimum": 1 },
        "calibration_basis": { "type": "string", "minLength": 1 },
        "universal_count": { "const": false }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
