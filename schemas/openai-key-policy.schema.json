{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/openai-key-policy.schema.json",
  "title": "Harness Ultragoal OpenAI Key Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "law_id",
    "env_var",
    "active_destination",
    "allowed_destinations",
    "destination_must_be_gitignored",
    "unix_mode_required",
    "secret_serialization_policy",
    "model_output_authority",
    "live_provider_requires",
    "provider_modes",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.openai-key-policy.v1"
    },
    "law_id": {
      "const": "openai-api-key-model-cost-external-ai-boundary"
    },
    "env_var": {
      "const": "OPENAI_API_KEY"
    },
    "active_destination": {
      "const": ".codex-worktree/env.sh"
    },
    "allowed_destinations": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "const": ".codex-worktree/env.sh"
      },
      "items": {
        "type": "string"
      }
    },
    "destination_must_be_gitignored": {
      "const": true
    },
    "unix_mode_required": {
      "const": "0600"
    },
    "secret_serialization_policy": {
      "const": "forbid"
    },
    "model_output_authority": {
      "const": "observation_only"
    },
    "live_provider_requires": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "string"
      }
    },
    "provider_modes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "enum": [
          "openai_live",
          "offline_fixture",
          "local_mock",
          "no_network"
        ]
      }
    },
    "claim_ceiling": {
      "const": "config_resolution_only"
    }
  }
}
