{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/openai-key-policy.schema.json",
  "title": "Harness Ultragoal OpenAI Key Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "law_id",
    "env_var",
    "active_destination",
    "active_destination_role",
    "allowed_destinations",
    "destination_must_be_gitignored",
    "unix_mode_required",
    "secret_serialization_policy",
    "model_output_authority",
    "live_provider_requires",
    "provider_modes",
    "current_execution_sanitation",
    "external_reconciliation",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.openai-key-policy.v1"
    },
    "law_id": {
      "const": "openai-api-key-model-cost-external-ai-boundary"
    },
    "env_var": {
      "const": "OPENAI_API_KEY"
    },
    "active_destination": {
      "const": ".codex-worktree/env.sh"
    },
    "active_destination_role": {
      "const": "optional_secret_compatibility_projection"
    },
    "allowed_destinations": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "const": ".codex-worktree/env.sh"
      },
      "items": {
        "type": "string"
      }
    },
    "destination_must_be_gitignored": {
      "const": true
    },
    "unix_mode_required": {
      "const": "0600"
    },
    "secret_serialization_policy": {
      "const": "forbid"
    },
    "model_output_authority": {
      "const": "observation_only"
    },
    "live_provider_requires": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "string"
      }
    },
    "provider_modes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "enum": [
          "openai_live",
          "offline_fixture",
          "local_mock",
          "no_network"
        ]
      }
    },
    "current_execution_sanitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "wrapper",
        "source_env_file",
        "inherits_host_environment",
        "secret_values_forwarded",
        "command_arguments_unrestricted",
        "caller_must_not_forward_or_source_secrets",
        "allowlisted_variables",
        "claim_ceiling"
      ],
      "properties": {
        "mode": {
          "const": "env_i_allowlist"
        },
        "wrapper": {
          "const": ".codex-worktree/run-command"
        },
        "source_env_file": {
          "const": false
        },
        "inherits_host_environment": {
          "const": false
        },
        "secret_values_forwarded": {
          "const": false
        },
        "command_arguments_unrestricted": {
          "const": true
        },
        "caller_must_not_forward_or_source_secrets": {
          "const": true
        },
        "allowlisted_variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "HOME"
          }
        },
        "claim_ceiling": {
          "const": "inherited_environment_sanitation_only"
        }
      }
    },
    "external_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_plaintext_key_claim",
        "owner_authorized_rotation_required",
        "external_revocation_status",
        "repo_execution_change_does_not_revoke_provider_credentials",
        "claim_ceiling"
      ],
      "properties": {
        "historical_plaintext_key_claim": {
          "const": "unverified_external_claim"
        },
        "owner_authorized_rotation_required": {
          "const": true
        },
        "external_revocation_status": {
          "const": "not_observed_or_performed"
        },
        "repo_execution_change_does_not_revoke_provider_credentials": {
          "const": true
        },
        "claim_ceiling": {
          "const": "historical_external_reconciliation_pending"
        }
      }
    },
    "claim_ceiling": {
      "const": "config_resolution_only"
    }
  }
}
