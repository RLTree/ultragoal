{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/final-packet-proof.schema.json",
  "title": "Harness Ultragoal Final Packet Proof Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "status",
    "target_revision",
    "packet",
    "cli_performance",
    "registry_exposure",
    "source_audit",
    "coverage",
    "package_receipts",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.final-packet-proof.v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "const": "pass"
    },
    "target_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "package_digest"
        },
        "value": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^validation_artifacts/review/[-A-Za-z0-9._/]+[.]json$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "cli_performance": {
      "$ref": "#/$defs/passReceiptRef"
    },
    "registry_exposure": {
      "$ref": "#/$defs/passReceiptRef"
    },
    "source_audit": {
      "$ref": "#/$defs/receiptRef"
    },
    "coverage": {
      "$ref": "#/$defs/receiptRef"
    },
    "package_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/receiptRef"
      }
    },
    "claim_ceiling": {
      "const": "final_packet_evidence_dereferenced"
    }
  },
  "$defs": {
    "receiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^validation_artifacts/cli/[-A-Za-z0-9._/]+[.]json$"
            },
            {
              "pattern": "^validation_artifacts/coverage/[-A-Za-z0-9._/]+[.]json$"
            },
            {
              "pattern": "^validation_artifacts/harness/[-A-Za-z0-9._/]+[.]json$"
            },
            {
              "pattern": "^validation_artifacts/ultragoal-audit/[-A-Za-z0-9._/]+[.]json$"
            }
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "passReceiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^validation_artifacts/cli/[-A-Za-z0-9._/]+[.]json$"
            },
            {
              "pattern": "^validation_artifacts/coverage/[-A-Za-z0-9._/]+[.]json$"
            },
            {
              "pattern": "^validation_artifacts/harness/[-A-Za-z0-9._/]+[.]json$"
            },
            {
              "pattern": "^validation_artifacts/ultragoal-audit/[-A-Za-z0-9._/]+[.]json$"
            }
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status": {
          "const": "pass"
        }
      }
    }
  }
}
