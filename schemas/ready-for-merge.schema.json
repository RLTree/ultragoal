{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/ready-for-merge.schema.json",
  "title": "Harness Ultragoal Ready For Merge Receipt",
  "type": "object",
  "required": [
    "schema",
    "generated_by",
    "provenance",
    "validator_version",
    "validator_run_id",
    "input_manifest_digest",
    "contract_bundle_digest",
    "lane_registry_digest",
    "lane_id",
    "ready",
    "base_commit",
    "commit",
    "branch",
    "target_branch",
    "target_head_at_launch",
    "target_head_at_validation",
    "live_target_head_at_generation",
    "merge_base",
    "target_freshness",
    "workspace",
    "execplan",
    "changed_files",
    "claim_ids",
    "commands",
    "evidence",
    "claim_ceiling",
    "worktree_clean",
    "teardown_ready",
    "blocked_reasons",
    "generated_at"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.ready-for-merge.v1"
    },
    "generated_by": {
      "const": "ultragoal-audit"
    },
    "provenance": {
      "type": "object",
      "required": [
        "validator_receipt",
        "generated_artifact_type",
        "validator_run_id",
        "input_manifest_digest"
      ],
      "properties": {
        "validator_receipt": {
          "$ref": "common-defs.schema.json#/$defs/artifactRef"
        },
        "generated_artifact_type": {
          "const": "ready_for_merge"
        },
        "validator_run_id": {
          "type": "string",
          "minLength": 1
        },
        "input_manifest_digest": {
          "$ref": "common-defs.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "validator_version": {
      "type": "string",
      "minLength": 1
    },
    "validator_run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_manifest_digest": {
      "$ref": "common-defs.schema.json#/$defs/sha256"
    },
    "contract_bundle_digest": {
      "$ref": "common-defs.schema.json#/$defs/sha256"
    },
    "lane_registry_digest": {
      "$ref": "common-defs.schema.json#/$defs/sha256"
    },
    "lane_id": {
      "$ref": "common-defs.schema.json#/$defs/laneId"
    },
    "ready": {
      "type": "boolean"
    },
    "base_commit": {
      "type": "string",
      "minLength": 7
    },
    "commit": {
      "type": "string",
      "minLength": 7
    },
    "branch": {
      "type": "string"
    },
    "target_branch": {
      "type": "string"
    },
    "target_head_at_launch": {
      "type": "string",
      "minLength": 7
    },
    "target_head_at_validation": {
      "type": "string",
      "minLength": 7
    },
    "live_target_head_at_generation": {
      "type": "string",
      "minLength": 7
    },
    "merge_base": {
      "type": "string",
      "minLength": 7
    },
    "target_freshness": {
      "type": "object",
      "required": [
        "target_head_matches_live",
        "merge_base_includes_target_head",
        "checked_at"
      ],
      "properties": {
        "target_head_matches_live": {
          "type": "boolean"
        },
        "merge_base_includes_target_head": {
          "type": "boolean"
        },
        "checked_at": {
          "$ref": "common-defs.schema.json#/$defs/isoTimestamp"
        },
        "stale_reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "string"
    },
    "execplan": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/claimId"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/commandReceipt"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/evidence"
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-defs.schema.json#/$defs/claimCeilingEntry"
      }
    },
    "worktree_clean": {
      "type": "boolean"
    },
    "teardown_ready": {
      "type": "boolean"
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "$ref": "common-defs.schema.json#/$defs/isoTimestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ready": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "claim_ids": {
            "minItems": 1
          },
          "commands": {
            "minItems": 1,
            "items": {
              "properties": {
                "exit": {
                  "const": 0
                }
              }
            }
          },
          "evidence": {
            "minItems": 1
          },
          "target_freshness": {
            "properties": {
              "target_head_matches_live": {
                "const": true
              },
              "merge_base_includes_target_head": {
                "const": true
              }
            }
          },
          "worktree_clean": {
            "const": true
          },
          "teardown_ready": {
            "const": true
          },
          "blocked_reasons": {
            "maxItems": 0
          },
          "claim_ceiling": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
