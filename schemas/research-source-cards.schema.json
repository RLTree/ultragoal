{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/research-source-cards.schema.json",
  "title": "Harness Ultragoal Research Source Cards",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "captured_at", "sources"],
  "properties": {
    "schema": { "const": "harness-ultragoal.research-source-cards.v1" },
    "captured_at": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "canonical_url",
          "source_kind",
          "source_artifact_digest",
          "source_artifact_method",
          "source_corpus_path",
          "source_corpus_digest",
          "evidence_anchors",
          "requirements"
        ],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "canonical_url": { "type": "string", "minLength": 1 },
          "source_kind": {
            "type": "string",
            "enum": ["public_web", "attached_user_source_card"]
          },
          "source_artifact_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "source_artifact_method": {
            "type": "string",
            "enum": [
              "http_body_sha256",
              "browser_verified_anchor_digest",
              "attached_source_card_digest",
              "local_archive_sha256"
            ]
          },
          "source_corpus_path": {
            "type": "string",
            "pattern": "^artifacts/source-snapshots/[a-z0-9][a-z0-9-]*\\.txt$"
          },
          "source_corpus_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "source_archive_path": { "type": "string", "minLength": 1 },
          "source_archive_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "source_archive_entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entry_path", "entry_digest"],
              "properties": {
                "entry_path": { "type": "string", "minLength": 1 },
                "entry_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              }
            }
          },
          "evidence_anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_id", "source_locator", "source_signal", "requirement_ids"],
              "properties": {
                "evidence_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "source_locator": { "type": "string", "minLength": 1 },
                "source_signal": { "type": "string", "minLength": 20 },
                "requirement_ids": { "$ref": "#/$defs/non_empty_strings" }
              }
            }
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requirement_id", "summary", "source_evidence_ids"],
              "properties": {
                "requirement_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "summary": { "type": "string", "minLength": 20 },
                "source_evidence_ids": { "$ref": "#/$defs/non_empty_strings" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
