{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/observability-query-result.schema.json",
  "title": "Harness Ultragoal Observability Query Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidate_digest",
    "run_id",
    "correlation_id",
    "why_failed",
    "where_failed",
    "next_repair",
    "query_kind",
    "query",
    "row_limit",
    "byte_limit",
    "timeout_ms",
    "retention_bound",
    "cardinality_guard",
    "truncated",
    "claim_impact",
    "result_digest",
    "rows",
    "failure",
    "supported_claims",
    "blocked_claims"
  ],
  "properties": {
    "schema": { "const": "harness-ultragoal.observability-query-result.v1" },
    "status": { "enum": ["pass", "fail", "blocked"] },
    "candidate_digest": { "$ref": "schema-authority-primitives.schema.json#/$defs/sha256" },
    "run_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "failure_class": { "type": "string" },
    "why_failed": { "type": "string" },
    "where_failed": { "type": "string" },
    "next_repair": { "type": "string", "minLength": 1 },
    "query_kind": { "enum": ["logs", "metrics", "traces"] },
    "query": { "type": "string", "minLength": 1 },
    "row_limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "byte_limit": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "retention_bound": { "type": "string", "minLength": 1 },
    "cardinality_guard": { "enum": ["bounded", "fail"] },
    "truncated": { "type": "boolean" },
    "row_count": { "type": "integer", "minimum": 0 },
    "byte_count": { "type": "integer", "minimum": 0 },
    "bounded_output_status": { "enum": ["pass", "fail"] },
    "redaction_status": { "enum": ["pass", "fail"] },
    "claim_impact": { "type": "string" },
    "result_digest": { "$ref": "schema-authority-primitives.schema.json#/$defs/sha256" },
    "observed_failure": { "type": ["object", "null"] },
    "observed_failure_class": { "type": "string" },
    "observed_why_failed": { "type": "string" },
    "observed_where_failed": { "type": "string" },
    "observed_next_repair": { "type": "string" },
    "observed_claim_impact": { "type": "string" },
    "observed_record": { "type": ["object", "null"] },
    "observed_operation": { "type": "string" },
    "observed_status": { "type": "string" },
    "observed_run_id": { "type": "string" },
    "observed_correlation_id": { "type": "string" },
    "observed_candidate_digest": { "type": "string" },
    "metric_operation": { "type": "string" },
    "metric_traffic_task_count": { "type": "integer", "minimum": 0 },
    "metric_traffic_count": { "type": "integer", "minimum": 0 },
    "metric_task_count": { "type": "integer", "minimum": 0 },
    "metric_queue_depth": { "type": "integer", "minimum": 0 },
    "metric_latency_ms": { "type": "integer", "minimum": 0 },
    "metric_error_count": { "type": "integer", "minimum": 0 },
    "metric_latest_sample_unix": { "type": "integer", "minimum": 0 },
    "metric_event_unix_seconds": { "type": "integer", "minimum": 0 },
    "metric_failure_class": { "type": "string" },
    "metric_saturation_status": { "type": "string" },
    "metric_high_cardinality_labels": { "enum": ["pass", "fail"] },
    "node_id": { "type": "string" },
    "operation": { "type": "string" },
    "backend_service": { "type": "string" },
    "endpoint_category": { "type": "string" },
    "backend_readiness_timeout_ms": { "type": "integer", "minimum": 1 },
    "rows": { "type": "array", "items": { "type": "object" } },
    "failure": { "type": "string" },
    "supported_claims": { "type": "array", "items": { "type": "string" } },
    "blocked_claims": { "type": "array", "items": { "type": "string" } }
  }
}
