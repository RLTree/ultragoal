{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/cli-performance-receipt.schema.json",
  "title": "Harness Ultragoal CLI Performance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "issuer",
    "generated_at",
    "root",
    "status",
    "claim_ceiling",
    "command",
    "budget",
    "digests",
    "input_size_metrics",
    "output_size_metrics",
    "cache",
    "concurrency",
    "telemetry",
    "external_probe_policy",
    "performance_regression",
    "speed_proof",
    "exit_code",
    "supported_claim_classes",
    "blocked_claim_classes",
    "failure",
    "commands"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.cli-performance-receipt.v1"
    },
    "schema_version": {
      "const": "v1"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "authority"
      ],
      "properties": {
        "tool": {
          "const": "ultragoal"
        },
        "authority": {
          "const": "cli_control_plane"
        }
      }
    },
    "generated_at": {
      "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
    },
    "root": {
      "const": "."
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "claim_ceiling": {
      "enum": [
        "source_local_speed_node_timing_only",
        "withheld_or_blocked"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "argv",
        "class",
        "evidence_affecting"
      ],
      "properties": {
        "name": {
          "enum": [
            "performance_budgets",
            "performance_prove",
            "performance_verify",
            "self_performance_prove"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "class": {
          "$ref": "#/$defs/budgetClass"
        },
        "evidence_affecting": {
          "const": true
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "class",
        "cold_p95_ms",
        "warm_p95_ms",
        "target_ms",
        "hard_ceiling_ms",
        "threshold_ms"
      ],
      "properties": {
        "version": {
          "const": "2026-06-26.performance-budget.v1"
        },
        "class": {
          "$ref": "#/$defs/budgetClass"
        },
        "cold_p95_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "warm_p95_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 600000
        },
        "target_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "hard_ceiling_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "threshold_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "candidate",
        "cli_binary",
        "schema_catalog",
        "law_graph",
        "standards",
        "fixture_catalog",
        "source_obligation",
        "config"
      ],
      "properties": {
        "source": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "candidate": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "cli_binary": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "schema_catalog": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "law_graph": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "standards": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "fixture_catalog": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "source_obligation": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "config": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        }
      }
    },
    "input_size_metrics": {
      "$ref": "#/$defs/metrics"
    },
    "output_size_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_count_written"
      ],
      "properties": {
        "receipt_count_written": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "key",
        "hits",
        "misses",
        "no_cache_mode_result"
      ],
      "properties": {
        "mode": {
          "enum": [
            "disabled",
            "verified",
            "no_cache_required"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "hits": {
          "type": "integer",
          "minimum": 0
        },
        "misses": {
          "type": "integer",
          "minimum": 0
        },
        "no_cache_mode_result": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "worker_count",
        "queue_depth",
        "isolation_namespace"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "worker_count": {
          "type": "integer",
          "minimum": 1
        },
        "queue_depth": {
          "type": "integer",
          "minimum": 0
        },
        "isolation_namespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_timestamp",
        "end_timestamp",
        "wall_clock_ms",
        "cpu_ms",
        "peak_memory_bytes",
        "io_bytes",
        "external_call_count",
        "external_wait_ms",
        "timeout_count",
        "retry_count"
      ],
      "properties": {
        "start_timestamp": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
        },
        "end_timestamp": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/isoTimestamp"
        },
        "wall_clock_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "io_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "external_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "external_wait_ms": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_count": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "external_probe_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_probe_class",
        "timeout_ms",
        "retry_backoff",
        "offline_fallback_claim_behavior"
      ],
      "properties": {
        "live_probe_class": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "retry_backoff": {
          "type": "string",
          "minLength": 1
        },
        "offline_fallback_claim_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "performance_regression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_version",
        "baseline_machine_class",
        "tolerance_percent",
        "status"
      ],
      "properties": {
        "baseline_version": {
          "const": "2026-06-26.performance-budget.v1"
        },
        "baseline_machine_class": {
          "type": "string",
          "minLength": 1
        },
        "tolerance_percent": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "speed_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes"
      ],
      "properties": {
        "status": {
          "enum": [
            "blocked",
            "pass"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speedProofNode"
          }
        },
        "first_blocker": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "proof_boundary": {
          "type": "string",
          "minLength": 1
        },
        "required_node_proof": {
          "type": "string",
          "minLength": 1
        },
        "claim_impact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exit_code": {
      "type": "integer"
    },
    "supported_claim_classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimClass"
      }
    },
    "blocked_claim_classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimClass"
      }
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "law_id",
            "gate_id",
            "check_id",
            "failed_invariant",
            "observed_value",
            "expected_value",
            "claim_ceiling_impact",
            "repair_class",
            "severity"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "law_id": {
              "const": "cli-performance-latency-speed-iteration-fitness"
            },
            "gate_id": {
              "const": "89.22"
            },
            "check_id": {
              "const": "cli-performance-latency-speed-iteration-fitness"
            },
            "failed_invariant": {
              "type": "string",
              "minLength": 1
            },
            "observed_value": {
              "type": "string",
              "minLength": 1
            },
            "expected_value": {
              "type": "string",
              "minLength": 1
            },
            "claim_ceiling_impact": {
              "type": "string",
              "minLength": 1
            },
            "repair_class": {
              "const": "deterministic_enforcement"
            },
            "severity": {
              "const": "hard_blocker"
            }
          }
        }
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "budgetClass": {
      "enum": [
        "external_live",
        "focused_repair",
        "hot_edit_check",
        "standard_source_local",
        "strict_coverage",
        "strict_final",
        "strict_fixtures",
        "strict_local"
      ]
    },
    "claimClass": {
      "enum": [
        "completion",
        "package_readiness",
        "product_readiness",
        "release_readiness",
        "routine_usability",
        "update_goal_eligibility"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_count_scanned",
        "fixture_count_executed",
        "receipt_count_read",
        "repository_size_class"
      ],
      "properties": {
        "file_count_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "fixture_count_executed": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_count_read": {
          "type": "integer",
          "minimum": 0
        },
        "repository_size_class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "speedProofNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "proof_kind",
        "candidate_digest",
        "cache_hit",
        "work_unit_count",
        "actual_work_duration_ms",
        "baseline_duration_ms",
        "verified_local_duration_ms",
        "required_speedup",
        "speedup_ratio",
        "graph_overhead_ms",
        "result_digest",
        "output_digest",
        "telemetry_reconciliation_status",
        "timing_status",
        "failure_class",
        "where_failed",
        "why_failed",
        "next_repair",
        "surface",
        "claim_impact"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "proof_kind": {
          "enum": [
            "executed",
            "verified_cache_hit"
          ]
        },
        "candidate_digest": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "cache_hit": {
          "type": "boolean"
        },
        "command_argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_status": {
          "type": "integer"
        },
        "work_unit_count": {
          "type": "integer",
          "minimum": 0
        },
        "actual_work_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "baseline_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "verified_local_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "required_speedup": {
          "type": "string",
          "minLength": 1
        },
        "speedup_ratio": {
          "type": "integer",
          "minimum": 0
        },
        "graph_overhead_ms": {
          "type": "integer",
          "minimum": 0
        },
        "result_digest": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "output_digest": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "receipt_paths": {
          "$ref": "#/$defs/artifactPathList"
        },
        "artifact_paths": {
          "$ref": "#/$defs/artifactPathList"
        },
        "telemetry_reconciliation_status": {
          "const": "pass"
        },
        "timing_status": {
          "const": "pass"
        },
        "failure_class": {
          "const": "none"
        },
        "where_failed": {
          "type": "string",
          "minLength": 1
        },
        "why_failed": {
          "type": "string",
          "minLength": 1
        },
        "next_repair": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "claim_impact": {
          "type": "string",
          "minLength": 1
        },
        "cache_key": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "current_input_digest": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "validator_version": {
          "type": "string",
          "minLength": 1
        },
        "law_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "fixture_version": {
          "type": "string",
          "minLength": 1
        },
        "prior_result_digest": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "replayed_output_digest": {
          "$ref": "schema-authority-primitives.schema.json#/$defs/sha256"
        },
        "equivalence_status": {
          "const": "verified_same_candidate_cache_replay"
        },
        "invalidation_proof": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "proof_kind": {
                "const": "executed"
              }
            },
            "required": [
              "proof_kind"
            ]
          },
          "then": {
            "required": [
              "command_argv",
              "exit_status"
            ],
            "properties": {
              "cache_hit": {
                "const": false
              },
              "work_unit_count": {
                "type": "integer",
                "minimum": 1
              }
            },
            "anyOf": [
              {
                "required": [
                  "receipt_paths"
                ]
              },
              {
                "required": [
                  "artifact_paths"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "proof_kind": {
                "const": "verified_cache_hit"
              }
            },
            "required": [
              "proof_kind"
            ]
          },
          "then": {
            "required": [
              "cache_key",
              "current_input_digest",
              "validator_version",
              "law_version",
              "schema_version",
              "fixture_version",
              "prior_result_digest",
              "replayed_output_digest",
              "equivalence_status",
              "invalidation_proof"
            ],
            "properties": {
              "cache_hit": {
                "const": true
              },
              "work_unit_count": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "artifactPathList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
