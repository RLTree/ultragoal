{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/observability-event.schema.json",
  "title": "Harness Ultragoal Observability Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "correlation_id",
    "trace_id",
    "span_id",
    "parent_span_id",
    "command",
    "subcommand",
    "operation",
    "surface",
    "law_id",
    "check_id",
    "claim_id",
    "candidate_digest",
    "target_revision",
    "artifact_path",
    "receipt_path",
    "status",
    "failure_class",
    "why_failed",
    "where_failed",
    "next_repair",
    "claim_impact",
    "timestamp",
    "duration_ms",
    "exporter",
    "redaction_status",
    "bounded_output_status",
    "query_hint_logql",
    "query_hint_promql",
    "query_hint_traceql"
  ],
  "properties": {
    "schema": { "const": "harness-ultragoal.observability-event.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "span_id": { "type": "string", "minLength": 1 },
    "parent_span_id": { "type": "string" },
    "command": { "type": "string", "minLength": 1 },
    "subcommand": { "type": "string" },
    "operation": { "type": "string", "minLength": 1 },
    "surface": { "enum": ["source", "installed", "cache", "app_registry", "reviewer", "live_stack", "target_repo"] },
    "law_id": { "type": "string" },
    "check_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "candidate_digest": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "target_revision": { "type": "string" },
    "artifact_path": { "type": "string" },
    "receipt_path": { "type": "string" },
    "status": { "enum": ["pass", "fail", "blocked"] },
    "failure_class": { "type": "string" },
    "why_failed": { "type": "string" },
    "where_failed": { "type": "string" },
    "next_repair": { "type": "string" },
    "claim_impact": { "type": "string" },
    "timestamp": { "$ref": "common-defs.schema.json#/$defs/isoTimestamp" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "exporter": { "enum": ["victorialogs", "local_spool", "stdout", "receipt"] },
    "redaction_status": { "enum": ["pass", "fail"] },
    "bounded_output_status": { "enum": ["pass", "fail", "truncated"] },
    "query_hint_logql": { "type": "string" },
    "query_hint_promql": { "type": "string" },
    "query_hint_traceql": { "type": "string" }
  }
}
