{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-ultragoal.local/schemas/product-live-surface-receipt.schema.json",
  "title": "Harness Ultragoal Product Live Surface Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "surface",
    "evidence",
    "substitutions_rejected",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "harness-ultragoal.product-live-surface-receipt.v1"
    },
    "surface": {
      "enum": [
        "live_ui",
        "live_recording",
        "live_replay",
        "live_transcript_alignment",
        "parent_operation_coordination"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-defs.schema.json#/$defs/artifactRef"
      }
    },
    "substitutions_rejected": {
      "type": "array",
      "contains": {
        "const": "cli_fixture_success"
      },
      "items": {
        "enum": [
          "cli_fixture_success",
          "install_success",
          "package_publication",
          "reviewer_agreement",
          "smoke_test"
        ]
      }
    },
    "claim_ceiling": {
      "enum": [
        "same_live_surface_only",
        "withheld_until_same_surface_receipt"
      ]
    }
  }
}
