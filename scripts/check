#!/usr/bin/env bash
set -euo pipefail

root="${1:-${CODEX_WORKTREE_PATH:-$PWD}}"
cd "$root"

echo "scripts/check compatibility aggregate: product plus governance only; it proves neither package/install/discovery/runtime/journey nor release." >&2
scripts/check-product "$root"
scripts/check-governance "$root"
scripts/check-next --quick "$root"
