#!/usr/bin/env bash
set -euo pipefail

root="${1:-${CODEX_WORKTREE_PATH:-$PWD}}"
cd "$root"

export CARGO_TARGET_DIR="$root/target/ultragoal-product-check"
export CARGO_PROFILE_RELEASE_DEBUG=0
unset HUL_ROUTINE_IMMUTABLE_BINARY

echo "check-product: source/package-local compile plus disposable same-binary product boundary tests; no install, real-host discovery, real-host state, representative repository journey, publication, deployment, release, or CL-USABLE-LOOP claim." >&2

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ultragoal-check-product.XXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT

assert_registered_once() {
  local list_path="$1"
  local test_name="$2"
  local count
  count="$(grep -Fxc -- "${test_name}: test" "$list_path" || true)"
  if [[ "$count" -ne 1 ]]; then
    echo "check-product registration failure: expected one registered test ${test_name}, observed ${count}" >&2
    exit 2
  fi
}

run_registered_tests() {
  local target_kind="$1"
  local target_name="$2"
  shift 2
  local list_path="$tmpdir/${target_kind}-${target_name}.list"
  local target_args=()
  if [[ "$target_kind" == "lib" ]]; then
    target_args=(--lib)
  else
    target_args=(--test "$target_name")
  fi
  cargo test --release -p ultragoal "${target_args[@]}" --locked -- --list >"$list_path"
  local test_name
  for test_name in "$@"; do
    assert_registered_once "$list_path" "$test_name"
  done
  for test_name in "$@"; do
    cargo test --release -p ultragoal "${target_args[@]}" --locked "$test_name" -- --exact --include-ignored --test-threads=1
  done
}

cargo check --release -p ultragoal --lib --locked
cargo build --release -p ultragoal --bin ultragoal --locked

# Public grammar/current-authority behavior and its fail-closed boundary.
