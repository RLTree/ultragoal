#!/usr/bin/env bash
set -euo pipefail

root="${1:-${CODEX_WORKTREE_PATH:-$PWD}}"
cd "$root"

receipt="${HARNESS_COVERAGE_RECEIPT:-validation_artifacts/coverage/coverage-receipt.json}"
jobs="${CARGO_BUILD_JOBS:-16}"

CARGO_BUILD_JOBS="$jobs" cargo build --offline --bin ultragoal --quiet
exec target/debug/ultragoal --root . coverage prove \
  --mode routine --receipt "$receipt" --jobs "$jobs"
