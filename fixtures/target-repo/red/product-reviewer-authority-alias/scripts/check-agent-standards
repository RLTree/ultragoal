#!/usr/bin/env bash
set -euo pipefail

root="${1:-${CODEX_WORKTREE_PATH:-$PWD}}"
cd "$root"

json_path="agent-standards/enforcement.json"
tsv_path="agent-standards/enforcement.tsv"
audit_path="agent-standards/enforcement-audit.tsv"

for path in "$json_path" "$tsv_path" "$audit_path"; do
  if [[ ! -f "$path" ]]; then
    echo "missing standards enforcement file: $path" >&2
    exit 1
  fi
done

python3 - "$json_path" "$tsv_path" "$audit_path" <<'PY'
import csv
import hashlib
import json
from pathlib import Path
import sys

json_path, tsv_path, audit_path = sys.argv[1:4]
root = Path.cwd()
data = json.load(open(json_path, encoding="utf-8"))
rows = data.get("rows", [])
if not rows:
    raise SystemExit("standards enforcement rows missing")

required_ids = {
    "authority-source-binding",
    "source-installed-cache-alignment",
    "reviewer-to-gate-conversion",
    "documentation-freshness",
    "runtime-tool-identity",
    "product-live-surface-receipts",
    "transcript-quality-reuse-gates",
    "privacy-raw-artifact-boundary",
    "coverage-proof-accountability",
    "coverage-scope-authority",
    "plugin-product-cohesion-authority",
    "std-product-fitness-001",
    "std-plans-001",
    "std-automation-001",
}
seen_ids = {row.get("id", "") for row in rows}
missing = sorted(required_ids - seen_ids)
if missing:
    raise SystemExit(f"standards enforcement required rows missing: {', '.join(missing)}")

allowed = {"mechanized", "backlogged", "blocked", "informational"}
for row in rows:
    row_id = row.get("id", "")
    status = row.get("enforcement_status", "")
    if status not in allowed:
        raise SystemExit(f"{row_id}: invalid or unclassified enforcement_status")
    refs = row.get("required_execplan_refs") or []
    if not refs:
        raise SystemExit(f"{row_id}: missing required_execplan_refs")
    if status == "mechanized" and not row.get("gate_or_fixture_path"):
        raise SystemExit(f"{row_id}: mechanized row missing gate_or_fixture_path")
    if status in {"backlogged", "blocked"} and not row.get("blocker_or_repair_action"):
        raise SystemExit(f"{row_id}: debt row missing blocker_or_repair_action")
    if status == "informational" and row.get("claim_ids_affected") != "none":
        raise SystemExit(f"{row_id}: informational row overclaims affected claims")

with open(tsv_path, encoding="utf-8", newline="") as f:
    tsv = {row["id"]: row for row in csv.DictReader(f, delimiter="\t")}
for row in rows:
    if tsv.get(row["id"], {}).get("enforcement_status") != row["enforcement_status"]:
        raise SystemExit(f"{row['id']}: enforcement.tsv drift")
    expected_refs = ";".join(row.get("required_execplan_refs") or [])
    if tsv.get(row["id"], {}).get("required_execplan_refs") != expected_refs:
        raise SystemExit(f"{row['id']}: enforcement.tsv execplan ref drift")

with open(audit_path, encoding="utf-8", newline="") as f:
    audits = {row["standard_id"]: row for row in csv.DictReader(f, delimiter="\t")}
for row in rows:
    if row["enforcement_status"] != "informational" and row["id"] not in audits:
        raise SystemExit(f"{row['id']}: enforcement audit missing")
for audit in audits.values():
    if audit.get("audit_status") != "pass":
        continue
    digest = audit.get("evidence_digest", "")
    if digest == "sha256:" + "0" * 64 or not digest.startswith("sha256:"):
        raise SystemExit(f"{audit['standard_id']}: pass audit row has invalid evidence_digest")
    rel = audit.get("evidence_path", "")
    candidates = [root / rel]
    if rel.startswith("scripts/"):
        candidates.append(root / "templates" / rel)
    evidence = next((path for path in candidates if path.is_file()), None)
    if evidence is None:
        raise SystemExit(f"{audit['standard_id']}: pass audit row evidence_path missing")
    actual = "sha256:" + hashlib.sha256(evidence.read_bytes()).hexdigest()
    if actual != digest:
        raise SystemExit(f"{audit['standard_id']}: pass audit row evidence_digest mismatch")
print(f"agent standards enforcement ok: {len(rows)} rows")
PY
