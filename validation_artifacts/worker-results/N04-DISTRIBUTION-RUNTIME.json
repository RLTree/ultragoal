  "changes": [
    {
      "area": "discovery-authority",
      "result": "Registry observation is AppRegistry-only. Discovery now uses host/discovery.json with schema harness-ultragoal.host-discovery.v1, exact confined root identity equal to the journey home, exact host binding equality, stable double-read, and visible=true. Supplying app/registry.json bytes to discovery is non-authoritative and fails ProvenanceMismatch."
    },
    {
      "area": "package-publication-authority",
      "result": "PackageArtifactTransaction is issued only through the confined repository output adapter, records journey binding sha256, output root id, and output relative path, and from_published_package rejects same-package cross-root or cross-journey rebinding."
    },
    {
      "area": "runtime-authority",
      "result": "Every host observation/probe calls the same HostCapabilityDeclaration-to-JourneyBinding equality guard. Runtime planning additionally requires the install snapshot to match the journey package, the supported install target plugins/harness-ultragoal.hugpkg, and the exact executable identity retained by the host capability. Probe output carries only a session nonce; runtime identity is derived independently from the bound plan."
    },
    {
      "area": "app-registry-boundary",
      "result": "AppRegistry identity remains tied to observe_registry_file/ScopedFile provenance. Arbitrary caller bytes can be validated structurally but cannot be promoted into the canonical AppRegistry surface."
    },
    {
      "area": "canonical-chain-binding",
      "result": "The public canonical verifier path remains the bound verifier, and mixed same-package/different-journey rows are rejected by binding digest checks."
    },
    {
      "area": "negative-controls",
      "result": "Added/updated controls for registry-visible discovery substitution, discovery-absent host state, cross-root/cross-journey package transplant, direct runtime executable substitution, wrong host/runtime identity, and unsupported marketplace/cache/registry inputs."
    }
  ],
