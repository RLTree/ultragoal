      "source_id": "agentic-gold-standard-stack-synthesis-2026-07-01",
      "title": "GPT-5.5 Pro gold-standard harness product doctrine synthesis",
      "canonical_url": "codex-attachment://agentic-gold-standard-stack-synthesis-2026-07-01",
      "source_kind": "attached_user_source_card",
      "requirements": [
        {
          "requirement_id": "gold-standard-harness-product-doctrine",
          "summary": "Harness Ultragoal is a productized agentic engineering harness; law-bearing surfaces must improve execution, verification, observability, repair, reliability, or claim integrity.",
          "source_evidence_ids": [
            "gold-standard-harness-product-doctrine-source-anchor"
          ]
        },
        {
          "requirement_id": "gold-standard-gate92-sensory-system",
          "summary": "Gate 92 is the agent sensory system and must cover metrics, traces, wide events, logs, evals, product/system health, and agent quality.",
          "source_evidence_ids": [
            "gold-standard-gate92-sensory-system-source-anchor"
          ]
        },
        {
          "requirement_id": "gold-standard-telemetry-envelope-cardinality",
          "summary": "Telemetry must carry agent, tool, repo, eval, command, law, claim, repair, duration, worker, cache, saturation, redaction, and boundedness attributes while keeping metric labels bounded.",
          "source_evidence_ids": [
            "gold-standard-telemetry-envelope-cardinality-source-anchor"
          ]
        },
        {
          "requirement_id": "gold-standard-agent-legible-query-explain",
          "summary": "Real command failures must support same-candidate query and explain output that tells an agent what failed, why, where, what claim is blocked, and the smallest repair.",
          "source_evidence_ids": [
            "gold-standard-agent-legible-query-explain-source-anchor"
          ]
        },
        {
          "requirement_id": "gold-standard-trace-feedback-eval-repair-promotion",
          "summary": "Failed traces, opaque output, bad repairs, slow workflows, corrections, near misses, stale evidence, and claim theater must become feedback, evals, fixtures, laws, or blockers.",
          "source_evidence_ids": [
            "gold-standard-trace-feedback-eval-repair-promotion-source-anchor"
          ]
        },
        {
          "requirement_id": "gold-standard-agents-routing-routine-command-surface",
          "summary": "AGENTS.md and setup or retrofit outputs must act as routing tables to canonical CLI commands, telemetry, evals, architecture, security, privacy, and quality gates.",
          "source_evidence_ids": [
            "gold-standard-agents-routing-routine-command-surface-anchor"
          ]
        },
        {
          "requirement_id": "gold-standard-tool-contract-risk-tiers",
          "summary": "Tools, adapters, model calls, live probes, setup helpers, and external writers must declare risk tier, approval, schemas, telemetry, failure semantics, and claim impact.",
          "source_evidence_ids": [
            "gold-standard-tool-contract-risk-tiers-source-anchor"
          ]
        },
        {
          "requirement_id": "gold-standard-truth-surface-separation",
          "summary": "Product truth, observability truth, and artifact truth must be cross-linked but non-substitutable across receipts, runtime behavior, live observability, source proof, install proof, and final packets.",
          "source_evidence_ids": [
            "gold-standard-truth-surface-separation-source-anchor"
          ]
        },
        {
          "requirement_id": "gold-standard-measured-improvement-agent-quality",
          "summary": "Gate 105 must measure system health and agent quality using same-surface telemetry for diagnosis time, repair time, reruns, stale evidence recurrence, opaque failures, claim theater, manual spelunking, entropy cleanup, eval trend, latency, and lane regressions.",
          "source_evidence_ids": [
            "gold-standard-measured-improvement-agent-quality-source-anchor"
          ]
        }
      ],
      "source_artifact_method": "attached_source_card_digest",
      "evidence_anchors": [
