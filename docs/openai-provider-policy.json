      "max_retries": 0,
      "backoff_policy": "none",
      "backoff_initial_ms": 0,
      "backoff_max_ms": 0,
      "cache_policy": "fixture_digest_only",
      "no_cache_verification": "offline_fixture_digest_bound",
      "rate_limit_policy": "not_applicable_without_live_provider",
      "allowed_claim_ceiling": "offline_fixture_observation_only"
    },
    "source_local_mock": {
      "provider_modes": [
        "local_mock"
      ],
      "max_prompt_tokens": 4096,
      "max_completion_tokens": 2048,
      "max_total_tokens": 6144,
      "cost_ceiling_usd": 0,
      "timeout_ms": 30000,
      "max_retries": 0,
      "backoff_policy": "none",
      "backoff_initial_ms": 0,
      "backoff_max_ms": 0,
      "cache_policy": "mock_digest_only",
      "no_cache_verification": "local_mock_digest_bound",
      "rate_limit_policy": "not_applicable_without_live_provider",
