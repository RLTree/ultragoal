{
  "schema": "harness-ultragoal.openai-key-policy.v1",
  "law_id": "openai-api-key-model-cost-external-ai-boundary",
  "env_var": "OPENAI_API_KEY",
  "active_destination": ".codex-worktree/env.sh",
  "active_destination_role": "optional_secret_compatibility_projection",
  "allowed_destinations": [
    ".codex-worktree/env.sh"
  ],
  "destination_must_be_gitignored": true,
  "unix_mode_required": "0600",
  "secret_serialization_policy": "forbid",
  "model_output_authority": "observation_only",
  "live_provider_requires": [
    "model_identity",
    "endpoint_api_family",
    "purpose",
    "prompt_input_digest",
    "output_digest",
    "schema_id",
    "budget_class",
    "provider_policy_digest",
    "timeout_retry_backoff",
    "token_cost_rate_limit_accounting",
    "cache_policy",
    "candidate_digest",
    "run_id",
    "correlation_id",
    "claim_impact"
  ],
  "provider_modes": [
    "openai_live",
    "offline_fixture",
    "local_mock",
    "no_network"
  ],
  "current_execution_sanitation": {
    "mode": "env_i_allowlist",
    "wrapper": ".codex-worktree/run-command",
    "source_env_file": false,
    "inherits_host_environment": false,
    "secret_values_forwarded": false,
    "command_arguments_unrestricted": true,
    "caller_must_not_forward_or_source_secrets": true,
    "allowlisted_variables": [
      "CODEX_WORKTREE_ROOT",
      "CODEX_WORKTREE_ID",
      "CODEX_WORKTREE_SCRATCH",
      "CODEX_WORKTREE_STATE",
      "CODEX_WORKTREE_HOME",
      "CODEX_WORKTREE_TMP",
      "CODEX_WORKTREE_PORT",
      "TMPDIR",
      "TMP",
      "TEMP",
      "HOST",
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_CACHE_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "CARGO_TARGET_DIR",
      "CARGO_LLVM_COV_TARGET_DIR",
      "CARGO_HOME",
      "RUSTUP_HOME",
      "CARGO_NET_OFFLINE",
      "HARNESS_ULTRAGOAL_PLUGIN_REPO",
      "HARNESS_ULTRAGOAL_VALIDATOR_MANIFEST",
      "HARNESS_ULTRAGOAL_VALIDATOR_RECEIPT",
      "PATH",
      "LANG",
      "LC_ALL"
    ],
    "claim_ceiling": "inherited_environment_sanitation_only"
  },
  "external_reconciliation": {
    "historical_plaintext_key_claim": "unverified_external_claim",
    "owner_authorized_rotation_required": true,
    "external_revocation_status": "not_observed_or_performed",
    "repo_execution_change_does_not_revoke_provider_credentials": true,
    "claim_ceiling": "historical_external_reconciliation_pending"
  },
  "claim_ceiling": "config_resolution_only"
}
