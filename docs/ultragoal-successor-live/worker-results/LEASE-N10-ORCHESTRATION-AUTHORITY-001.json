    {
      "area": "sealed issuance and binding",
      "rationale": "RootPermit authenticity covers root actor, full binding, exact workspace and journal identities, causal observation, target, action, and request."
    },
    {
      "area": "pre-reservation execution authorization",
      "rationale": "Runtime validation now creates a private authority-bound single-use token before any durable reserve transition, preventing clone poisoning and substitution."
    },
    {
      "area": "durable replay and recovery",
      "rationale": "The owner-only authenticated ledger records Issued, Reserved, Committed, Refused, and Ambiguous states with descriptor and object identity checks."
    },
    {
      "area": "rollback claim ceiling",
      "rationale": "The local checkpoint is private and process-bound; all nonempty fresh-process reopen fails closed instead of claiming external monotonic authenticity."
    },
    {
      "area": "adversarial controls",
      "rationale": "Focused tests exercise replay, interruption, restart refusal, ambiguity, reconciliation, same-head clones, stale copies, same-inode rollback, races, mutation, security, and false-pass cases."
    }
