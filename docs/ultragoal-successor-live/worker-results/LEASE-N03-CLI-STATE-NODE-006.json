  "findings": [
    {
      "severity": "corrected-candidate",
      "finding": "The root REWORK disclosure path is removed from the candidate surfaces: explicit secrets reach artifact finalization before observable artifact values exist, and secret-ambiguous artifacts expose only the withheld representation."
    },
    {
      "severity": "secret-safe-observability",
      "finding": "Full secrets, environment-only secrets, overlapping sets, every nonempty terminal proper prefix after public leading bytes, raw bytes, compact/Debug numeric forms, and prefixed/bare raw digests are absent from CapturedArtifact, ArtifactRef, artifact JSON, and canonical CapturedRun JSON in focused tests."
    },
    {
      "severity": "control-preserved",
      "finding": "Positive non-secret artifacts retain bytes, digest, resolver behavior, ordering, and candidate/context binding; focused dependency controls retain bounds, symlink, hardlink, FIFO, mutation, process, output-budget, and policy behavior."
    },
    {
      "severity": "security-proof-gap",
      "finding": "On this POSIX/macOS substrate, fstatat preflight and openat are separate operations. A path changed from a regular file to a special file in that interval can be opened nonblocking and then rejected before read. Static special paths are rejected before open, but atomic reject-before-open under substitution is not proved."
    },
    {
      "severity": "sandbox-runtime-gap",
      "finding": "The outer sandbox prevented a representative nested sandbox-exec success-path run and can prohibit filesystem Unix-socket binding. The socket test uses a real bound path when permitted and an explicit mode-classification fallback on PermissionDenied; real socket-path proof in this run is withheld."
    },
    {
      "severity": "independent-rereview-required",
      "finding": "This worker does not accept its own implementation, evidence receipt, or exact artifact set. Fresh independent security, concurrency, false-pass, schema-shape, and exact-set rereview remains required."
    },
    {
      "severity": "public-integration-unresolved",
      "finding": "Public dispatcher, canonical schema/generated authority, migration reconciliation, and representative zero-write CLI journeys remain root-owned and were neither modified nor verified by this lease."
    },
    {
      "severity": "node-claim-withheld",
      "finding": "N03 closure, readiness, release, and completion remain withheld."
    }
