  "changes": [
    {
      "area": "pending stream observation",
      "result": "Reader threads now return a non-serializable PendingOutput. They process only bytes that are safe before the redaction look-behind boundary and cannot finalize, hash, or serialize the undecidable tail."
    },
    {
      "area": "stable combined outcome",
      "result": "Process execution joins both reader threads before propagating either reader result. OutputBudget snapshots the stable global overflow once and applies the same fact to both finalizations and termination reconciliation."
    },
    {
      "area": "secret and disclosure safety",
      "result": "On stable global overflow, every ambiguous trailing bound-secret prefix is replaced before emit/hash/serialization. Both affected streams disclose truncated, observation_limit_exceeded, and captured_byte_length_is_lower_bound."
    },
    {
      "area": "deterministic false-pass control",
      "result": "A channel-gated reader claims every proper prefix, blocks at its EOF read, and is released only after the second reader overflows. The matrix swaps stream roles, finalization order, and overlapping-secret insertion order without sleeps or scheduler assumptions."
    },
    {
      "area": "boundary preservation",
      "result": "True EOF, exact single and combined boundaries, multichunk secrets, ordinary nonsecret output, per-stream retention truncation, zero, one, production-minimum overlap, and 4096-byte maximum controls retain their intended semantics."
    }
  ],
