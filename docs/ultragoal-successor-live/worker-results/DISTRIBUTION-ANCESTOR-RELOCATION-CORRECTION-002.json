  "changes": [
    {
      "area": "root-anchored-directory-resolution",
      "result": "Directory no longer retains a descendant mutation descriptor. Its anchor descriptor, relative path, and expected identity are re-resolved before every filesystem operation; a relocated or replaced ancestor fails as ObjectChanged before a mutating syscall."
    },
    {
      "area": "mutation-boundary-rebinding",
      "result": "rename_noreplace, rename_swap, quarantine/disposal rename, unlinkat, mkdirat, create-file, and read/open paths use fresh anchor-derived descriptors after the deterministic effect hook."
    },
    {
      "area": "ancestor-relocation-regressions",
      "result": "The imported chained OpenDirectory-plus-Rename adversary now proves outside prior bytes remain unchanged on overwrite/swap and removal/fallback; the matching tree-target test proves the directory path also rejects without outside-tree mutation."
    }
  ],
