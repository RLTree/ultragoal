{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness-ultragoal:WorkerResult-v1",
  "title": "WorkerResult-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worker",
    "lease_id",
    "context_id",
    "candidate_identity",
    "base_state",
    "final_state",
    "touched_paths",
    "touched_semantics",
    "generated_outputs",
    "fixtures",
    "effects",
    "requirements",
    "dependency_nodes",
    "changes",
    "commands_and_tests",
    "artifacts",
    "findings",
    "unresolved_dependencies",
    "requested_root_changes",
    "limitations",
    "no_claim_statement"
  ],
  "properties": {
    "worker": {"type": "string", "minLength": 1},
    "lease_id": {"type": "string", "minLength": 1},
    "context_id": {"type": "string", "minLength": 1},
    "candidate_identity": {"type": "object"},
    "base_state": {"type": "object"},
    "final_state": {"type": "object"},
    "touched_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "touched_semantics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "generated_outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "fixtures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "effects": {"type": "array", "items": {"type": "object"}},
    "requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependency_nodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "changes": {"type": "array", "items": {"type": "object"}},
    "commands_and_tests": {"type": "array", "items": {"type": "object"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "unresolved_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requested_root_changes": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "no_claim_statement": {"const": "This worker does not claim readiness, release, or completion."}
  }
}
