    "root_only_surfaces": [".codex", ".agents", ".git"],
    "protected_root_patterns": [".codex", ".codex/**", ".agents", ".agents/**", ".git", ".git/**", "**/.git", "**/.git/**", "**/.git/refs/**"],
    "git_metadata_rule": "normalize absolute paths and symlinks, resolve linked-worktree gitdir, and protect .git files, gitdir targets, and gitdir refs",
    "overlap_examples": {
      "positive_rejections": [
        {"path": "<worktree>/.git", "reason": "linked-worktree git metadata file"},
        {"path": "<worktree>/.git/refs/heads/x", "reason": "git metadata ref"},
        {"path": "<resolved-gitdir>/refs/heads/x", "reason": "resolved gitdir ref target"}
      ],
      "negative_allows": [
        {"path": "docs/refs/example.md", "reason": "non-Git documentation path"},
        {"path": "src/refs/example.rs", "reason": "non-Git source path"}
      ]
    },
    "isolated_roots": {"HOME": "<lease>/home", "CARGO_HOME": "<lease>/cargo", "RUSTUP_HOME": "<lease>/rustup", "target": "<lease>/target", "tmp": "<lease>/tmp", "cache": "<lease>/cache", "port": "<lease>/port", "scratch": "<lease>/scratch", "artifact": "<lease>/artifact", "credentials": "<lease>/credentials"},
    "overlap_verdict": "disjoint_required",
