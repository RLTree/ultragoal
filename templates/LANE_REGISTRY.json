    "id_rule": "N00-N17",
    "dependency_rule": "Use FINAL-CONTRACT graph dependencies; scheduler frontier is N04-N07 after N03, N09 after N02+N05, N08 after N04-N07, N10 after N03+N06+N09, N11 after N06+N07+N08, N12 after N10+N11.",
    "scope_rule": "Use only graph write scopes. Root-only nodes have empty scope_ids and fail closed. N13 is read-only multi-scope.",
    "lease_rule": "Global typed lease schema/template only; unissued lanes carry no resolved record. Resolve branch/worktree, owned paths/symbols/generated/fixtures/effects, forbidden roots, and all ten isolated roots before issuance.",
    "ref_rule": "Resolve all eight source refs as one current byte set; stale, missing, historical, or partial refs block selection.",
    "retention_rule": "Never broad-delete .codex-worktree while unique fixture repositories or retained home/tmp evidence exist."
  },
  "lease_record": {
